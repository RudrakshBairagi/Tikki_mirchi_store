{%- assign s = section.settings -%}

{%- assign bg_color = s.bg_color | default: '#000000' -%}
{%- assign surface_bg_color = s.surface_bg_color | default: '#080808' -%}
{%- assign text_color = s.text_color | default: '#ffffff' -%}
{%- assign muted_text_color = s.muted_text_color | default: '#999999' -%}
{%- assign accent_color = s.accent_color | default: '#d4af37' -%}
{%- assign border_color = s.border_color | default: 'rgba(255, 255, 255, 0.12)' -%}
{%- assign line_thickness = s.line_thickness | default: 1 -%}
{%- assign button_bg_color = s.button_bg_color | default: '#ffffff' -%}
{%- assign button_text_color = s.button_text_color | default: '#000000' -%}

{%- assign header_logo_text = s.header_logo_text | default: 'Teekhi Bella' -%}
{%- assign logo_font_size_desktop = s.logo_font_size_desktop | default: 40 -%}
{%- assign logo_font_size_mobile = s.logo_font_size_mobile | default: 34 -%}

{%- assign product_title = s.product_title | default: "cvnt's genda phool skirt" -%}
{%- assign product_price = s.product_price | default: '₹2,975' -%}
{%- assign product_compare_price = s.product_compare_price | default: '₹3,500' -%}
{%- assign rating_score = s.rating_score | default: '4.0' -%}
{%- assign rating_count_text = s.rating_count_text | default: 'By 1+ buyer' -%}

{%- assign default_waitlist_url = routes.root_url | append: 'pages/waitlist' | replace: '//', '/' -%}
{%- assign waitlist_url = s.buy_now_url | default: s.nav_waitlist_url | default: default_waitlist_url -%}

{{ 'header-morph.css' | asset_url | stylesheet_tag }}
{{ 'product-inspect.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-morph.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-inspect.js' | asset_url }}" defer="defer"></script>

<script>
  window.__cvntMeowAudioUrl = '{{ s.custom_audio_url | default: "cvnt-cat-meow.mp3" | asset_url }}';
</script>

<style>
  @font-face {
    font-family: 'Ahsing';
    src: url('{{ "Ahsing.woff" | asset_url }}') format('woff'),
         url('{{ "Ahsing.otf" | asset_url }}') format('opentype'),
         url('{{ "typogama-ahsing.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara-Italic.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara-Italic.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara-Italic.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  {%- if s.logo_font_source == 'shopify' and s.logo_font != blank -%}
    {{ s.logo_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if s.title_font_source == 'shopify' and s.title_font != blank -%}
    {{ s.title_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  :root {
    {%- if s.logo_font_source == 'ahsing' -%}
      --header-logo-font: 'Ahsing', serif;
    {%- elsif s.logo_font_source == 'ragara' -%}
      --header-logo-font: 'Ragara', 'Italiana', Georgia, serif;
    {%- elsif s.logo_font_source == 'syne' -%}
      --header-logo-font: 'Syne', sans-serif;
    {%- elsif s.logo_font_source == 'bodoni' -%}
      --header-logo-font: 'Bodoni Moda', serif;
    {%- elsif s.logo_font_source == 'playfair' -%}
      --header-logo-font: 'Playfair Display', serif;
    {%- elsif s.logo_font_source == 'shopify' and s.logo_font != blank -%}
      --header-logo-font: {{ s.logo_font.family }}, {{ s.logo_font.fallback_families }};
    {%- elsif s.logo_font_source == 'custom' and s.custom_logo_font != blank -%}
      --header-logo-font: '{{ s.custom_logo_font }}', serif;
    {%- else -%}
      --header-logo-font: 'Ahsing', serif;
    {%- endif -%}

    {%- if s.title_font_source == 'ahsing' -%}
      --pdp-title-font: 'Ahsing', serif;
    {%- elsif s.title_font_source == 'ragara' -%}
      --pdp-title-font: 'Ragara', 'Italiana', Georgia, serif;
    {%- elsif s.title_font_source == 'syne' -%}
      --pdp-title-font: 'Syne', sans-serif;
    {%- elsif s.title_font_source == 'shopify' and s.title_font != blank -%}
      --pdp-title-font: {{ s.title_font.family }}, {{ s.title_font.fallback_families }};
    {%- elsif s.title_font_source == 'custom' and s.custom_title_font != blank -%}
      --pdp-title-font: '{{ s.custom_title_font }}', sans-serif;
    {%- else -%}
      --pdp-title-font: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, sans-serif;
    {%- endif -%}

    --header-tagline-font: 'Italiana', Georgia, serif;
    --header-nav-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --header-logo-spacing: 0.02em;

    /* Theme Dynamic Colors & Lines */
    --pdp-bg: {{ bg_color }};
    --pdp-surface: {{ surface_bg_color }};
    --pdp-text: {{ text_color }};
    --pdp-muted: {{ muted_text_color }};
    --pdp-accent: {{ accent_color }};
    --pdp-border: {{ border_color }};
    --pdp-line-thickness: {{ line_thickness }}px;
    --pdp-btn-bg: {{ button_bg_color }};
    --pdp-btn-text: {{ button_text_color }};
  }

  {%- if s.enable_chili_cursor != false -%}
    /* Custom Chili Cursor */
    html, body, .product-inspect-wrapper {
      cursor: url('{{ "chili-cursor-32.png" | asset_url }}') 0 0, auto !important;
      cursor: -webkit-image-set(url('{{ "chili-cursor-32.png" | asset_url }}') 1x, url('{{ "chili-cursor-64.png" | asset_url }}') 2x) 0 0, auto !important;
    }

    a, button, [role="button"], input, select, textarea, label,
    .nav-link, .menu-toggle, .header-action-btn,
    .ProductDetailExperience_colorThumbButton__2sQvm,
    .ProductDetailExperience_variantLabel__VkJns,
    .ProductDetailExperience_quantityButton__6Nxre,
    .ProductDetailExperience_buyNowButton__6tiNm,
    .ProductDetailExperience_addToCartButton__egkl6,
    .ProductDetailExperience_detailButton__nHj7N,
    .ProductDetailExperience_miniatureButton__bPKNm,
    .MeowButton_button__GaaqF,
    .dropdown-nav-link,
    .inspect-font-pill,
    .inspect-font-studio-link {
      cursor: url('{{ "chili-cursor-32.png" | asset_url }}') 0 0, pointer !important;
      cursor: -webkit-image-set(url('{{ "chili-cursor-32.png" | asset_url }}') 1x, url('{{ "chili-cursor-64.png" | asset_url }}') 2x) 0 0, pointer !important;
    }
  {%- endif -%}
  
  /* Luxury Header Styling */
  #LuxuryHeader {
    --docked-bg-color: rgba(5, 5, 5, 0.92) !important;
    --docked-text-color: #f5f5f5 !important;
    --header-border-docked: {{ border_color }} !important;
    z-index: 150 !important;
    font-family: var(--header-nav-font, "Plus Jakarta Sans", sans-serif) !important;
  }
  #LuxuryHeader .brand-morph-logo,
  #LuxuryHeader .brand-wordmark {
    font-family: var(--header-logo-font, "Ahsing", serif) !important;
    font-weight: 400 !important;
    font-size: {{ logo_font_size_desktop }}px !important;
    color: #f5f5f5 !important;
    letter-spacing: 0.02em !important;
    text-transform: none !important;
    text-decoration: none !important;
  }
  #LuxuryHeader .nav-link {
    color: #f5f5f5 !important;
    font-family: var(--header-nav-font, "Plus Jakarta Sans", sans-serif) !important;
    font-size: 11px !important;
    letter-spacing: 0.2em !important;
    font-weight: 500 !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
  }
  #LuxuryHeader .header-action-btn.menu-toggle {
    color: #f5f5f5 !important;
  }
  #LuxuryHeader .menu-toggle .btn-label {
    color: #f5f5f5 !important;
  }
  #LuxuryHeader .menu-toggle:hover {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
  }

  @media (max-width: 768px) {
    #LuxuryHeader .brand-morph-logo,
    #LuxuryHeader .brand-wordmark {
      font-size: {{ logo_font_size_mobile }}px !important;
      line-height: 0.95 !important;
    }
  }

  /* Dynamic CSS overrides based on section settings */
  .product-inspect-wrapper,
  .product-inspect-wrapper main {
    background-color: var(--pdp-bg) !important;
    color: var(--pdp-text) !important;
  }
  .ProductDetailExperience_pageSurface__LIloS {
    background-color: var(--pdp-surface) !important;
  }
  .ProductDetailExperience_productHeading__fwjkS {
    font-family: var(--pdp-title-font) !important;
    color: var(--pdp-text) !important;
  }
  .ProductDetailExperience_priceRegular__f_WJq {
    color: var(--pdp-text) !important;
  }
  .ProductDetailExperience_buyNowButton__6tiNm {
    background: var(--pdp-btn-bg) !important;
    color: var(--pdp-btn-text) !important;
  }
  .ProductDetailExperience_detailButton__nHj7N {
    border-top: var(--pdp-line-thickness) solid var(--pdp-border) !important;
  }
  .ProductDetailExperience_detailLinks__m3QxJ {
    border-bottom: var(--pdp-line-thickness) solid var(--pdp-border) !important;
  }

  /* Floating Header Font Switcher */
  .inspect-font-bar {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99999;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(14, 13, 17, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(212, 175, 55, 0.15);
    animation: floatIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes floatIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .inspect-font-bar__label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--header-nav-font, "Plus Jakarta Sans", sans-serif);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #cbb479;
    white-space: nowrap;
  }
  .inspect-font-bar__pills {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .inspect-font-pill {
    padding: 5px 11px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e5e5e7;
    font-family: var(--header-nav-font, "Plus Jakarta Sans", sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.22s ease;
    white-space: nowrap;
  }
  .inspect-font-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(212, 175, 55, 0.5);
    color: #fff;
    transform: translateY(-1px);
  }
  .inspect-font-pill.active {
    background: linear-gradient(135deg, #d4af37 0%, #b38728 100%);
    border-color: #f3e5ab;
    color: #0b0a0d;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.35);
  }
  .inspect-font-studio-link {
    font-family: var(--header-nav-font, "Plus Jakarta Sans", sans-serif);
    font-size: 11px;
    font-weight: 600;
    color: #cbb479;
    text-decoration: none;
    padding: 5px 10px;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    margin-left: 4px;
    transition: color 0.2s ease;
  }
  .inspect-font-studio-link:hover {
    color: #fff;
  }

  @media (max-width: 768px) {
    .inspect-font-bar {
      bottom: 12px;
      right: 12px;
      left: 12px;
      justify-content: space-between;
      padding: 6px 10px;
      overflow-x: auto;
    }
    .inspect-font-bar__label {
      display: none;
    }
  }
</style>

