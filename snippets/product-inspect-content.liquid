  <div id="cvnt-drawer-care" hidden data-drawer-title="{{ s.care_tab_label | default: 'Care' | escape }}">
    <section class="ProductDetailExperience_drawerSection__UWR7M">
      <h3 class="ProductDetailExperience_drawerSectionTitle__QyY5C">{{ s.care_heading | default: 'Care' }}</h3>
      <div class="ProductDetailExperience_drawerSectionBody__Iwl44">
        <p>{{ s.care_text | default: 'Hand wash with cold water or dry clean only.' | newline_to_br }}</p>
      </div>
    </section>
  </div>

  <!-- Floating Header Font Switcher Pill for Testing -->
  <aside class="inspect-font-bar" id="inspectFontBar" aria-label="Header Font Switcher">
    <div class="inspect-font-bar__label">
      <span class="font-bar-icon">✦</span>
      <span class="font-bar-text">Header Font:</span>
    </div>
    <div class="inspect-font-bar__pills">
      <button type="button" class="inspect-font-pill active" data-font="'Ahsing', serif" data-spacing="0.02em" data-weight="400" data-transform="none">Ahsing</button>
      <button type="button" class="inspect-font-pill" data-font="'Ragara', 'Italiana', Georgia, serif" data-spacing="0.04em" data-weight="400" data-transform="none">Ragara</button>
      <button type="button" class="inspect-font-pill" data-font="'Syne', sans-serif" data-spacing="0.04em" data-weight="800" data-transform="uppercase">Syne</button>
      <button type="button" class="inspect-font-pill" data-font="'Bodoni Moda', serif" data-spacing="0.02em" data-weight="700" data-transform="uppercase">Bodoni</button>
      <button type="button" class="inspect-font-pill" data-font="'Playfair Display', serif" data-spacing="0.03em" data-weight="600" data-transform="none">Playfair</button>
    </div>
    <a href="{{ routes.root_url }}#studio" class="inspect-font-studio-link" title="Open Studio on Home">Studio ↗</a>
  </aside>

  <script>
    (function() {
      const pills = document.querySelectorAll('.inspect-font-pill');
      const root = document.documentElement;
      const logoEl = document.querySelector('#LuxuryHeader .brand-morph-logo');
      const wordmarkEl = document.querySelector('#LuxuryHeader .brand-wordmark');

      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          pills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');

          const font = pill.getAttribute('data-font');
          const spacing = pill.getAttribute('data-spacing') || '0.02em';
          const weight = pill.getAttribute('data-weight') || '400';
          const transform = pill.getAttribute('data-transform') || 'none';

          root.style.setProperty('--header-logo-font', font);
          root.style.setProperty('--header-logo-spacing', spacing);
          
          if (wordmarkEl) {
            wordmarkEl.style.fontFamily = font;
            wordmarkEl.style.letterSpacing = spacing;
            wordmarkEl.style.fontWeight = weight;
            wordmarkEl.style.textTransform = transform;
          }
          if (logoEl) {
            logoEl.style.fontFamily = font;
          }
        });
      });
    })();
  </script>
</div>
