{%- assign ws = ws | default: section.settings | default: section_settings -%}
{%- assign wl_bg = ws.bg_color | default: '#f8f8f6' -%}
{%- assign wl_card_bg = ws.card_bg_color | default: '#ffffff' -%}
{%- assign wl_text = ws.text_color | default: '#1a1819' -%}
{%- assign wl_muted = ws.muted_text_color | default: '#666666' -%}
{%- assign wl_accent = ws.accent_color | default: '#b38728' -%}
{%- assign wl_border = ws.border_color | default: '#e2e0da' -%}
{%- assign wl_input_bg = ws.input_bg_color | default: '#fafaf8' -%}
{%- assign wl_submit_bg = ws.submit_btn_bg | default: '#1a1819' -%}
{%- assign wl_submit_text = ws.submit_btn_text_color | default: '#ffffff' -%}
{{ 'atelier-waitlist.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Italiana&family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
{%- if ws.title_font_source == 'custom' and ws.custom_title_font != blank -%}
  {%- assign custom_font_slug = ws.custom_title_font | replace: ' ', '+' -%}
  <link href="https://fonts.googleapis.com/css2?family={{ custom_font_slug }}:wght@400;600;700&display=swap" rel="stylesheet">
{%- endif -%}
<script src="{{ 'atelier-waitlist.js' | asset_url }}" defer="defer"></script>

{% render 'font-faces' %}

<style>
  /* Font faces loaded via snippets/font-faces.liquid */

  {%- if ws.title_font_source == 'shopify' and ws.title_font != blank -%}
    {{ ws.title_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  :root {

    {%- if ws.title_font_source == 'ahsing' -%}
      --wl-title-font: 'Ahsing', serif;
    {%- elsif ws.title_font_source == 'ragara' -%}
      --wl-title-font: 'Ragara', 'Italiana', Georgia, serif;
    {%- elsif ws.title_font_source == 'syne' -%}
      --wl-title-font: 'Syne', sans-serif;
    {%- elsif ws.title_font_source == 'bodoni' -%}
      --wl-title-font: 'Bodoni Moda', serif;
    {%- elsif ws.title_font_source == 'playfair' -%}
      --wl-title-font: 'Playfair Display', serif;
    {%- elsif ws.title_font_source == 'italiana' -%}
      --wl-title-font: 'Italiana', Georgia, serif;
    {%- elsif ws.title_font_source == 'cinzel' -%}
      --wl-title-font: 'Cinzel', serif;
    {%- elsif ws.title_font_source == 'cormorant' -%}
      --wl-title-font: 'Cormorant Garamond', serif;
    {%- elsif ws.title_font_source == 'outfit' -%}
      --wl-title-font: 'Outfit', sans-serif;
    {%- elsif ws.title_font_source == 'shopify' and ws.title_font != blank -%}
      --wl-title-font: {{ ws.title_font.family }}, {{ ws.title_font.fallback_families }};
    {%- elsif ws.title_font_source == 'custom' and ws.custom_title_font != blank -%}
      --wl-title-font: '{{ ws.custom_title_font }}', serif;
    {%- else -%}
      --wl-title-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    {%- endif -%}

    --wl-bg: {{ wl_bg }};
    --wl-card-bg: {{ wl_card_bg }};
    --wl-text: {{ wl_text }};
    --wl-text-main: {{ wl_text }};
    --wl-muted: {{ wl_muted }};
    --wl-text-muted: {{ wl_muted }};
    --wl-accent: {{ wl_accent }};
    --wl-accent-gold: {{ wl_accent }};
    --wl-accent-gold-light: {{ wl_accent }};
    --wl-border: {{ wl_border }};
    --wl-border-light: {{ wl_border }};
    --wl-input-bg: {{ wl_input_bg }};
    --wl-submit-bg: {{ wl_submit_bg }};
    --wl-btn-bg: {{ wl_submit_bg }};
    --wl-submit-text: {{ wl_submit_text }};
    --wl-btn-text: {{ wl_submit_text }};
    --wl-font-serif: var(--wl-title-font, 'Plus Jakarta Sans', serif);
    --wl-font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  #atelierWaitlistSection {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }



  .waitlist-page {
    position: relative;
    overflow: hidden;
    {%- if ws.bg_mode == 'gradient' and ws.bg_gradient != blank -%}
      background: {{ ws.bg_gradient }} !important;
    {%- elsif ws.bg_mode == 'solid' -%}
      background-color: var(--wl-bg) !important;
    {%- else -%}
      {%- if ws.bg_image != blank -%}
        background-image: url('{{ ws.bg_image | image_url: width: 2600 }}') !important;
      {%- else -%}
        background-image: url('{{ "background.jpg" | asset_url }}') !important;
      {%- endif -%}
      background-size: cover !important;
      background-position: center !important;
    {%- endif -%}
  }
  .waitlist-bg-overlay {
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: {{ ws.bg_overlay_opacity | default: 0 | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }
  .waitlist-main-wrap {
    position: relative;
    z-index: 2;
  }
  .waitlist-form-card {
    background-color: var(--wl-card-bg) !important;
    border-color: var(--wl-border) !important;
    position: relative;
    z-index: 2;
  }
  .waitlist-title {
    font-family: var(--wl-title-font, 'Plus Jakarta Sans') !important;
    font-size: calc(clamp(2rem, 3.8vw, 2.75rem) * {{ ws.title_scale | default: 100 | divided_by: 100.0 }}) !important;
    letter-spacing: {{ ws.title_letter_spacing | default: 0 }}px !important;
    color: var(--wl-text) !important;
  }
  .waitlist-subtitle {
    color: var(--wl-muted) !important;
  }
  .form-section-title,
  .form-input-wrap label,
  .dress-card-title {
    color: var(--wl-text) !important;
  }
  .dresses-helper-text,
  .dress-card-price,
  .size-guide-hint,
  .waitlist-disclaimer {
    color: var(--wl-muted) !important;
  }
  .form-input-wrap input,
  .form-input-wrap select,
  .phone-input-group {
    background-color: var(--wl-input-bg) !important;
    border-color: var(--wl-border) !important;
    color: var(--wl-text) !important;
  }
  .size-select-pill {
    background-color: var(--wl-input-bg) !important;
    border-color: var(--wl-border) !important;
    color: var(--wl-text) !important;
  }
  .size-select-pill.is-active {
    background-color: var(--wl-text) !important;
    border-color: var(--wl-text) !important;
    color: var(--wl-card-bg) !important;
  }
  .size-select-pill.is-active .size-pill-name,
  .size-select-pill.is-active .size-pill-detail {
    color: var(--wl-card-bg) !important;
  }
  .waitlist-submit-btn {
    background-color: var(--wl-submit-bg) !important;
    color: var(--wl-submit-text) !important;
  }
</style>

<div class="waitlist-page" id="atelierWaitlistSection">
  <div class="waitlist-bg-overlay" aria-hidden="true"></div>


  <!-- ==========================================================================
       MAIN WAITLIST INTERACTIVE EXPERIENCE
       ========================================================================== -->
  {%- if ws.form_style == 'card' -%}
<main class="waitlist-main-wrap">
    
    <!-- Hero Header -->
    <div class="waitlist-hero-header">
      {%- assign eyebrow_text = ws.eyebrow | default: 'Summer Atelier 2026' -%}
      {%- if eyebrow_text != blank -%}
        <div class="waitlist-eyebrow">
          <span>✦</span>
          <span>{{ eyebrow_text }}</span>
          <span>✦</span>
        </div>
      {%- endif -%}
      <h1 class="waitlist-title">{{ ws.title | default: 'Sign up to our waitlist!' }}</h1>
      {%- assign subtitle_text = ws.subtitle | default: 'Complete the form below to reserve your bespoke piece from our exclusive runway drop.' -%}
      {%- if subtitle_text != blank -%}
        <p class="waitlist-subtitle">{{ subtitle_text }}</p>
      {%- endif -%}
    </div>

    <!-- Waitlist Form Card -->
    <div class="waitlist-form-card">
      <form id="atelierWaitlistForm" class="atelier-waitlist-form" novalidate>

        <!-- Step 1: Client Information (Indian Standard) -->
        <div class="form-section-title">
          <span class="step-num">1</span>
          <span>{{ ws.step_1_title | default: 'Your Information' }}</span>
        </div>

        <div class="waitlist-fields-grid">
          <!-- Full Name -->
          <div class="form-input-wrap">
            <label for="waitlistFullName">{{ ws.name_label | default: 'Full Name *' }}</label>
            <input
              type="text"
              id="waitlistFullName"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="{{ ws.name_placeholder | default: 'Enter your full name' }}"
              required
            >
          </div>

          <!-- Email -->
          <div class="form-input-wrap">
            <label for="waitlistEmail">{{ ws.email_label | default: 'Email Address *' }}</label>
            <input
              type="email"
              id="waitlistEmail"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="{{ ws.email_placeholder | default: 'name@example.com' }}"
              required
            >
          </div>

          <!-- Phone Number with Country Prefix -->
          <div class="form-input-wrap">
            <label for="waitlistPhone">{{ ws.phone_label | default: 'Phone Number (WhatsApp VIP Access) *' }}</label>
            <div class="phone-input-group">
              <span class="phone-prefix">{{ ws.phone_prefix | default: '+91' }}</span>
              <input
                type="tel"
                id="waitlistPhone"
                name="contact[phone]"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="{{ ws.phone_placeholder | default: '98765 43210 (For WhatsApp drop access & VIP alerts)' }}"
                maxlength="10"
                required
              >
            </div>
          </div>

          <!-- Indian Standards: City, State/UT, and 6-digit PIN Code -->
          <div class="form-field-row form-field-row-3">
            <div class="form-input-wrap">
              <label for="waitlistCity">{{ ws.city_label | default: 'City *' }}</label>
              <input
                type="text"
                id="waitlistCity"
                name="contact[city]"
                placeholder="{{ ws.city_placeholder | default: 'e.g. Mumbai / Delhi / Jaipur' }}"
                required
              >
            </div>

            <div class="form-input-wrap">
              <label for="waitlistState">{{ ws.state_label | default: 'State / UT *' }}</label>
              <select id="waitlistState" name="contact[state]" required>
                <option value="" disabled selected>Select State / UT</option>
                <option value="Maharashtra">Maharashtra</option>
                <option value="Delhi (NCR)">Delhi (NCR)</option>
                <option value="Karnataka">Karnataka</option>
                <option value="Rajasthan">Rajasthan</option>
                <option value="Gujarat">Gujarat</option>
                <option value="Telangana">Telangana</option>
                <option value="Tamil Nadu">Tamil Nadu</option>
                <option value="Uttar Pradesh">Uttar Pradesh</option>
                <option value="Punjab">Punjab</option>
                <option value="West Bengal">West Bengal</option>
                <option value="Haryana">Haryana</option>
                <option value="Madhya Pradesh">Madhya Pradesh</option>
                <option value="Kerala">Kerala</option>
                <option value="Goa">Goa</option>
                <option value="Andhra Pradesh">Andhra Pradesh</option>
                <option value="Assam">Assam</option>
                <option value="Bihar">Bihar</option>
                <option value="Chandigarh">Chandigarh</option>
                <option value="Chhattisgarh">Chhattisgarh</option>
                <option value="Himachal Pradesh">Himachal Pradesh</option>
                <option value="Jammu and Kashmir">Jammu and Kashmir</option>
                <option value="Jharkhand">Jharkhand</option>
                <option value="Odisha">Odisha</option>
                <option value="Uttarakhand">Uttarakhand</option>
                <option value="Other">Other / International</option>
              </select>
            </div>

            <div class="form-input-wrap">
              <label for="waitlistPincode">{{ ws.pincode_label | default: 'PIN Code *' }}</label>
              <input
                type="text"
                id="waitlistPincode"
                name="contact[pincode]"
                placeholder="{{ ws.pincode_placeholder | default: '6 Digits (e.g. 400050)' }}"
                maxlength="6"
                pattern="[0-9]{6}"
                required
              >
            </div>
          </div>
        </div>

        <!-- Step 2: Select Dresses (Runway Looks) -->
        <div class="waitlist-dresses-section">
          <div class="dresses-section-header">
            <div class="form-section-title">
              <span class="step-num">2</span>
              <span>{{ ws.step_2_title | default: 'Select Your Desired Runway Dresses' }}</span>
            </div>
            <p class="dresses-helper-text">{{ ws.step_2_subtitle | default: 'Click on any dress tile to select or unselect. You can select multiple dresses.' }}</p>
          </div>

          <!-- Dresses Tiles Grid -->
          <div class="dress-tiles-grid" id="dressTilesGrid">

            <!-- Dress 1 -->
            {%- assign d1_img = 'hanger-look-1.png' | asset_url -%}
            {%- if ws.dress_1_img != blank -%}{%- assign d1_img = ws.dress_1_img | image_url: width: 600 -%}{%- endif -%}
            {%- assign d1_title = ws.dress_1_title | default: 'Archival Manuscript Corset Gown' -%}
            {%- assign d1_price = ws.dress_1_price | default: 'Edition 01 • ₹74,500' -%}
            <div class="dress-tile-card is-selected" data-index="1" data-title="{{ d1_title | escape }}" data-price="{{ d1_price | escape }}" data-img="{{ d1_img }}">
              <div class="dress-card-badge">Look 01</div>
              <div class="dress-card-check">✓</div>
              <div class="dress-card-img-wrap"><img src="{{ d1_img }}" alt="{{ d1_title | escape }}" loading="lazy"></div>
              <div class="dress-card-info">
                <h3 class="dress-card-title">{{ d1_title }}</h3>
                <div class="dress-card-price">{{ d1_price }}</div>
              </div>
            </div>

            <!-- Dress 2 -->
            {%- assign d2_img = 'hanger-look-2.png' | asset_url -%}
            {%- if ws.dress_2_img != blank -%}{%- assign d2_img = ws.dress_2_img | image_url: width: 600 -%}{%- endif -%}
            {%- assign d2_title = ws.dress_2_title | default: 'Heritage Mural Mirror Lehenga' -%}
            {%- assign d2_price = ws.dress_2_price | default: 'Edition 02 • ₹1,25,000' -%}
            <div class="dress-tile-card" data-index="2" data-title="{{ d2_title | escape }}" data-price="{{ d2_price | escape }}" data-img="{{ d2_img }}">
              <div class="dress-card-badge">Look 02</div>
              <div class="dress-card-check">✓</div>
              <div class="dress-card-img-wrap"><img src="{{ d2_img }}" alt="{{ d2_title | escape }}" loading="lazy"></div>
              <div class="dress-card-info">
                <h3 class="dress-card-title">{{ d2_title }}</h3>
                <div class="dress-card-price">{{ d2_price }}</div>
              </div>
            </div>

            <!-- Dress 3 -->
            {%- assign d3_img = 'hanger-look-3.png' | asset_url -%}
            {%- if ws.dress_3_img != blank -%}{%- assign d3_img = ws.dress_3_img | image_url: width: 600 -%}{%- endif -%}
            {%- assign d3_title = ws.dress_3_title | default: 'Rose-Coral Shimmer Saree Gown' -%}
            {%- assign d3_price = ws.dress_3_price | default: 'Edition 03 • ₹98,000' -%}
            <div class="dress-tile-card" data-index="3" data-title="{{ d3_title | escape }}" data-price="{{ d3_price | escape }}" data-img="{{ d3_img }}">
              <div class="dress-card-badge">Look 03</div>
              <div class="dress-card-check">✓</div>
              <div class="dress-card-img-wrap"><img src="{{ d3_img }}" alt="{{ d3_title | escape }}" loading="lazy"></div>
              <div class="dress-card-info">
                <h3 class="dress-card-title">{{ d3_title }}</h3>
                <div class="dress-card-price">{{ d3_price }}</div>
              </div>
            </div>

            <!-- Dress 4 -->
            {%- assign d4_img = 'hanger-look-4.png' | asset_url -%}
            {%- if ws.dress_4_img != blank -%}{%- assign d4_img = ws.dress_4_img | image_url: width: 600 -%}{%- endif -%}
            {%- assign d4_title = ws.dress_4_title | default: 'Midnight Botanical Co-ord Set' -%}
            {%- assign d4_price = ws.dress_4_price | default: 'Edition 04 • ₹92,000' -%}
            <div class="dress-tile-card" data-index="4" data-title="{{ d4_title | escape }}" data-price="{{ d4_price | escape }}" data-img="{{ d4_img }}">
              <div class="dress-card-badge">Look 04</div>
              <div class="dress-card-check">✓</div>
              <div class="dress-card-img-wrap"><img src="{{ d4_img }}" alt="{{ d4_title | escape }}" loading="lazy"></div>
              <div class="dress-card-info">
                <h3 class="dress-card-title">{{ d4_title }}</h3>
                <div class="dress-card-price">{{ d4_price }}</div>
              </div>
            </div>

            <!-- Dress 5 -->
            {%- assign d5_img = 'hanger-look-5.png' | asset_url -%}
            {%- if ws.dress_5_img != blank -%}{%- assign d5_img = ws.dress_5_img | image_url: width: 600 -%}{%- endif -%}
            {%- assign d5_title = ws.dress_5_title | default: 'Bordeaux Peplum Halter Gown' -%}
            {%- assign d5_price = ws.dress_5_price | default: 'Edition 05 • ₹1,10,000' -%}
            <div class="dress-tile-card" data-index="5" data-title="{{ d5_title | escape }}" data-price="{{ d5_price | escape }}" data-img="{{ d5_img }}">
              <div class="dress-card-badge">Look 05</div>
              <div class="dress-card-check">✓</div>
              <div class="dress-card-img-wrap"><img src="{{ d5_img }}" alt="{{ d5_title | escape }}" loading="lazy"></div>
              <div class="dress-card-info">
                <h3 class="dress-card-title">{{ d5_title }}</h3>
                <div class="dress-card-price">{{ d5_price }}</div>
              </div>
            </div>

            <!-- Dress 6 -->
            {%- assign d6_img = 'hanger-look-6.png' | asset_url -%}
            {%- if ws.dress_6_img != blank -%}{%- assign d6_img = ws.dress_6_img | image_url: width: 600 -%}{%- endif -%}
            {%- assign d6_title = ws.dress_6_title | default: 'Scarlet Blossom Twist-Knot Gown' -%}
            {%- assign d6_price = ws.dress_6_price | default: 'Edition 06 • ₹86,500' -%}
            <div class="dress-tile-card" data-index="6" data-title="{{ d6_title | escape }}" data-price="{{ d6_price | escape }}" data-img="{{ d6_img }}">
              <div class="dress-card-badge">Look 06</div>
              <div class="dress-card-check">✓</div>
              <div class="dress-card-img-wrap"><img src="{{ d6_img }}" alt="{{ d6_title | escape }}" loading="lazy"></div>
              <div class="dress-card-info">
                <h3 class="dress-card-title">{{ d6_title }}</h3>
                <div class="dress-card-price">{{ d6_price }}</div>
              </div>
            </div>

          </div>
        </div>

        <!-- Step 3: Size Selection -->
        <div class="waitlist-size-section">
          <div class="size-section-header">
            <div class="form-section-title" style="margin-bottom:0;">
              <span class="step-num">3</span>
              <span>{{ ws.step_3_title | default: 'Select Your Size' }}</span>
            </div>
            <span class="size-guide-hint">{{ ws.step_3_badge | default: 'Indian Standard Couture Fit' }}</span>
          </div>

          <div class="size-pills-row">
            <button type="button" class="size-select-pill" data-size="{{ ws.size_pill_1_name | default: 'XS' }} ({{ ws.size_pill_1_detail | default: 'Bust 32 in' }})">
              <span class="size-pill-name">{{ ws.size_pill_1_name | default: 'XS' }}</span>
              <span class="size-pill-detail">{{ ws.size_pill_1_detail | default: 'Bust 32 in' }}</span>
            </button>
            <button type="button" class="size-select-pill" data-size="{{ ws.size_pill_2_name | default: 'S' }} ({{ ws.size_pill_2_detail | default: 'Bust 34 in' }})">
              <span class="size-pill-name">{{ ws.size_pill_2_name | default: 'S' }}</span>
              <span class="size-pill-detail">{{ ws.size_pill_2_detail | default: 'Bust 34 in' }}</span>
            </button>
            <button type="button" class="size-select-pill is-active" data-size="{{ ws.size_pill_3_name | default: 'M' }} ({{ ws.size_pill_3_detail | default: 'Bust 36 in' }})">
              <span class="size-pill-name">{{ ws.size_pill_3_name | default: 'M' }}</span>
              <span class="size-pill-detail">{{ ws.size_pill_3_detail | default: 'Bust 36 in' }}</span>
            </button>
            <button type="button" class="size-select-pill" data-size="{{ ws.size_pill_4_name | default: 'L' }} ({{ ws.size_pill_4_detail | default: 'Bust 38 in' }})">
              <span class="size-pill-name">{{ ws.size_pill_4_name | default: 'L' }}</span>
              <span class="size-pill-detail">{{ ws.size_pill_4_detail | default: 'Bust 38 in' }}</span>
            </button>
            <button type="button" class="size-select-pill" data-size="{{ ws.size_pill_5_name | default: 'XL' }} ({{ ws.size_pill_5_detail | default: 'Bust 40 in' }})">
              <span class="size-pill-name">{{ ws.size_pill_5_name | default: 'XL' }}</span>
              <span class="size-pill-detail">{{ ws.size_pill_5_detail | default: 'Bust 40 in' }}</span>
            </button>
            <button type="button" class="size-select-pill" data-size="{{ ws.size_pill_6_name | default: 'XXL' }} ({{ ws.size_pill_6_detail | default: 'Bust 42 in' }})">
              <span class="size-pill-name">{{ ws.size_pill_6_name | default: 'XXL' }}</span>
              <span class="size-pill-detail">{{ ws.size_pill_6_detail | default: 'Bust 42 in' }}</span>
            </button>
            <button type="button" class="size-select-pill" data-size="{{ ws.size_pill_custom_name | default: 'Custom' }} ({{ ws.size_pill_custom_detail | default: 'Made-to-Measure' }})" data-is-custom="true">
              <span class="size-pill-name">{{ ws.size_pill_custom_name | default: 'Custom' }}</span>
              <span class="size-pill-detail">{{ ws.size_pill_custom_detail | default: 'Made-to-Measure' }}</span>
            </button>
          </div>

          <!-- Optional Custom Measurement Row (Toggles when Custom is chosen) -->
          <div class="custom-measurements-row" id="customMeasurementsRow">
            <div class="form-input-wrap">
              <label for="customMeasurementsInput">{{ ws.custom_measurements_label | default: 'Custom Sizing Details (Optional):' }}</label>
              <input
                type="text"
                id="customMeasurementsInput"
                placeholder="{{ ws.custom_measurements_placeholder | default: 'e.g. Bust 35, Waist 28, Hips 38, Height 5ft 6in' }}"
              >
            </div>
          </div>
        </div>

        <!-- Hidden Form Serializations -->
        <input type="hidden" id="waitlistSizeInput" name="contact[size]" value='M (UK 10 / Bust 36")'>
        <input type="hidden" id="selectedDressesSummary" name="contact[selected_looks]" value="">
        <input type="hidden" id="contactBodySummary" name="contact[body]" value="">

        <!-- Submit Button -->
        <div class="waitlist-submit-wrap">
          <button type="submit" class="waitlist-submit-btn" id="waitlistSubmitBtn">
            <span>{{ ws.submit_btn_text | default: 'Submit Reservation' }}</span>
          </button>
          <p class="waitlist-disclaimer">
            {{ ws.disclaimer_text | default: 'By signing up, you agree to receive private collection drops & VIP runway access via WhatsApp / SMS. View our privacy policy and terms of service for more info.' }}
          </p>
        </div>

      </form>

      <!-- Confirmation / Success View for client-side fallback -->
      <div class="waitlist-success-view" id="waitlistSuccessView">
        <div class="success-badge">{{ ws.success_badge_text | default: '✦ Reservation Confirmed ✦' }}</div>
        <h2 class="success-title">{{ ws.success_title | default: "You're on the exclusive waitlist!" }}</h2>
        <p class="success-msg">
          {{ ws.success_desc | default: 'Thank you for joining. When our private atelier drop opens, your VIP access link and priority checkout code will be dispatched directly to your WhatsApp and email.' }}
        </p>
        <div class="success-receipt-card" id="receiptDetails"></div>
        <div class="success-actions">
          <a href="{{ routes.root_url }}" class="success-rack-btn">
            <span>⟵</span>
            <span>{{ ws.return_btn_text | default: 'Return to Runway Rack' }}</span>
          </a>
          <button type="button" class="success-secondary-btn" id="reserveAnotherBtn">
            <span>+</span>
            <span>{{ ws.reserve_another_btn_text | default: 'Reserve Another Look' }}</span>
          </button>
        </div>
      </div>

    </div>
  </main>
{%- elsif ws.form_style == 'google_form' and ws.google_form_url != blank -%}
  <main class="waitlist-page-content">
    <section class="waitlist-hero-minimal" {%- if ws.bg_image != blank -%}style="background-image: url('{{ ws.bg_image | image_url: width: 2600 }}');"{%- else -%}style="background-image: url('{{ 'background.jpg' | asset_url }}');"{%- endif -%}>
      <div class="waitlist-minimal-overlay" aria-hidden="true" style="opacity: {{ ws.bg_overlay_opacity | default: 25 | divided_by: 100.0 }};"></div>
      <div class="waitlist-minimal-inner" style="max-width: 800px; width: 100%;">
        <iframe src="{{ ws.google_form_url }}" width="100%" height="800" frameborder="0" marginheight="0" marginwidth="0" style="border-radius: 12px; background: rgba(255,255,255,0.95);">Loading…</iframe>
      </div>
    </section>
  </main>
{%- else -%}
  <main class="waitlist-page-content">
    {%- assign hero_bg_image = ws.bg_image | default: nil -%}
    <section
      class="wl-split-section"
      style="{%- if hero_bg_image != blank -%}background-image: url('{{ hero_bg_image | image_url: width: 2600 }}');{%- else -%}background-image: url('{{ "background.jpg" | asset_url }}');{%- endif -%}"
    >
      <div class="wl-split-overlay" aria-hidden="true" style="opacity: {{ ws.bg_overlay_opacity | default: 0 | divided_by: 100.0 }};"></div>

      <!-- LEFT: Outfit Showcase -->
      <div class="wl-left-panel">
        <div class="wl-left-header">
          {%- if ws.eyebrow != blank -%}
            <div class="wl-left-eyebrow">{{ ws.eyebrow }}</div>
          {%- endif -%}
          <h1 class="wl-left-title">{{ ws.title | default: 'Sign Up For<br>Exclusive Access' }}</h1>
          <p class="wl-left-sub">{{ ws.subtitle | default: 'Select one or more teekhi bella pieces. Tap outfits to select or unselect.' }}</p>
        </div>

        <!-- 5 Outfit Cards — clicking any look toggles selection (multi-select supported) -->
        <div class="wl-looks-grid">
          {%- comment -%} Look 01 {%- endcomment -%}
          {%- assign look_1_title = ws.dress_1_title | default: 'Archival Manuscript Corset Gown' -%}
          {%- assign look_1_img = ws.dress_1_img | default: nil -%}
          <div class="wl-look-card is-selected" data-value="{{ look_1_title | escape }}" tabindex="0" role="button" aria-pressed="true" title="Click to toggle selection">
            <div class="wl-look-img-wrap">
              {%- if look_1_img != blank -%}
                <img src="{{ look_1_img | image_url: width: 600 }}" alt="{{ look_1_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'hanger-look-1.png' | asset_url }}" alt="{{ look_1_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="wl-look-info">
              <span class="wl-look-num">01</span>
              <span class="wl-look-name">{{ look_1_title | replace: ' Corset Gown', '<br>Corset Gown' | replace: ' Lehenga', '<br>Lehenga' | replace: ' Saree Gown', '<br>Saree Gown' | replace: ' Co-ord Set', '<br>Co-ord Set' | replace: ' Halter Gown', '<br>Halter Gown' }}</span>
            </div>
            <div class="wl-look-check" aria-hidden="true">✓</div>
          </div>

          {%- comment -%} Look 02 {%- endcomment -%}
          {%- assign look_2_title = ws.dress_2_title | default: 'Heritage Mural Mirror Lehenga' -%}
          {%- assign look_2_img = ws.dress_2_img | default: nil -%}
          <div class="wl-look-card" data-value="{{ look_2_title | escape }}" tabindex="0" role="button" aria-pressed="false" title="Click to toggle selection">
            <div class="wl-look-img-wrap">
              {%- if look_2_img != blank -%}
                <img src="{{ look_2_img | image_url: width: 600 }}" alt="{{ look_2_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'hanger-look-2.png' | asset_url }}" alt="{{ look_2_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="wl-look-info">
              <span class="wl-look-num">02</span>
              <span class="wl-look-name">{{ look_2_title | replace: ' Mirror Lehenga', '<br>Mirror Lehenga' | replace: ' Lehenga', '<br>Lehenga' }}</span>
            </div>
            <div class="wl-look-check" aria-hidden="true">✓</div>
          </div>

          {%- comment -%} Look 03 {%- endcomment -%}
          {%- assign look_3_title = ws.dress_3_title | default: 'Rose-Coral Shimmer Saree Gown' -%}
          {%- assign look_3_img = ws.dress_3_img | default: nil -%}
          <div class="wl-look-card" data-value="{{ look_3_title | escape }}" tabindex="0" role="button" aria-pressed="false" title="Click to toggle selection">
            <div class="wl-look-img-wrap">
              {%- if look_3_img != blank -%}
                <img src="{{ look_3_img | image_url: width: 600 }}" alt="{{ look_3_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'hanger-look-3.png' | asset_url }}" alt="{{ look_3_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="wl-look-info">
              <span class="wl-look-num">03</span>
              <span class="wl-look-name">{{ look_3_title | replace: ' Saree Gown', '<br>Saree Gown' }}</span>
            </div>
            <div class="wl-look-check" aria-hidden="true">✓</div>
          </div>

          {%- comment -%} Look 04 {%- endcomment -%}
          {%- assign look_4_title = ws.dress_4_title | default: 'Midnight Botanical Co-ord Set' -%}
          {%- assign look_4_img = ws.dress_4_img | default: nil -%}
          <div class="wl-look-card" data-value="{{ look_4_title | escape }}" tabindex="0" role="button" aria-pressed="false" title="Click to toggle selection">
            <div class="wl-look-img-wrap">
              {%- if look_4_img != blank -%}
                <img src="{{ look_4_img | image_url: width: 600 }}" alt="{{ look_4_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'hanger-look-4.png' | asset_url }}" alt="{{ look_4_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="wl-look-info">
              <span class="wl-look-num">04</span>
              <span class="wl-look-name">{{ look_4_title | replace: ' Co-ord Set', '<br>Co-ord Set' }}</span>
            </div>
            <div class="wl-look-check" aria-hidden="true">✓</div>
          </div>

          {%- comment -%} Look 05 {%- endcomment -%}
          {%- assign look_5_title = ws.dress_5_title | default: 'Bordeaux Peplum Halter Gown' -%}
          {%- assign look_5_img = ws.dress_5_img | default: nil -%}
          <div class="wl-look-card" data-value="{{ look_5_title | escape }}" tabindex="0" role="button" aria-pressed="false" title="Click to toggle selection">
            <div class="wl-look-img-wrap">
              {%- if look_5_img != blank -%}
                <img src="{{ look_5_img | image_url: width: 600 }}" alt="{{ look_5_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'hanger-look-5.png' | asset_url }}" alt="{{ look_5_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="wl-look-info">
              <span class="wl-look-num">05</span>
              <span class="wl-look-name">{{ look_5_title | replace: ' Halter Gown', '<br>Halter Gown' }}</span>
            </div>
            <div class="wl-look-check" aria-hidden="true">✓</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Minimalist Form Panel -->
      <div class="wl-right-panel">
        <form id="waitlistMinimalForm" class="wl-form" novalidate>

          <!-- Email -->
          <div class="wl-field">
            <label for="waitlistEmail">{{ ws.email_label | default: 'Email' | replace: ' *', '' | replace: ' Address', '' }}</label>
            <input type="email" id="waitlistEmail" placeholder="{{ ws.email_placeholder | default: 'your@email.com' }}" autocomplete="email" required>
          </div>

          <!-- Phone -->
          <div class="wl-field">
            <label for="waitlistPhone">{{ ws.phone_label | default: 'Phone' | replace: ' *', '' | replace: ' Number', '' | replace: ' (WhatsApp VIP Access)', '' }}</label>
            <div class="wl-phone-row">
              <span class="wl-phone-cc">{{ ws.phone_prefix | default: '+91' }}</span>
              <input type="tel" id="waitlistPhone" placeholder="98765 43210" maxlength="10" pattern="[0-9]{10}" required>
            </div>
          </div>

          <!-- State -->
          <div class="wl-field">
            <label for="waitlistState">{{ ws.state_label | default: 'State' | replace: ' *', '' | replace: ' / UT', '' }}</label>
            <select id="waitlistState" required>
              <option value="" disabled selected>Select state</option>
              <option value="Andhra Pradesh">Andhra Pradesh</option>
              <option value="Arunachal Pradesh">Arunachal Pradesh</option>
              <option value="Assam">Assam</option>
              <option value="Bihar">Bihar</option>
              <option value="Chhattisgarh">Chhattisgarh</option>
              <option value="Delhi">Delhi (NCR)</option>
              <option value="Goa">Goa</option>
              <option value="Gujarat">Gujarat</option>
              <option value="Haryana">Haryana</option>
              <option value="Himachal Pradesh">Himachal Pradesh</option>
              <option value="Jharkhand">Jharkhand</option>
              <option value="Karnataka">Karnataka</option>
              <option value="Kerala">Kerala</option>
              <option value="Madhya Pradesh">Madhya Pradesh</option>
              <option value="Maharashtra">Maharashtra</option>
              <option value="Manipur">Manipur</option>
              <option value="Meghalaya">Meghalaya</option>
              <option value="Mizoram">Mizoram</option>
              <option value="Nagaland">Nagaland</option>
              <option value="Odisha">Odisha</option>
              <option value="Punjab">Punjab</option>
              <option value="Rajasthan">Rajasthan</option>
              <option value="Sikkim">Sikkim</option>
              <option value="Tamil Nadu">Tamil Nadu</option>
              <option value="Telangana">Telangana</option>
              <option value="Tripura">Tripura</option>
              <option value="Uttar Pradesh">Uttar Pradesh</option>
              <option value="Uttarakhand">Uttarakhand</option>
              <option value="West Bengal">West Bengal</option>
              <option value="Other / International">Other / International</option>
            </select>
          </div>

          <!-- Pieces of Interest: Multi-Select Chips (Synced with outfit cards) -->
          <div class="wl-field">
            <div class="wl-field-header">
              <label>Pieces of Interest</label>
              <span class="wl-select-hint">Select Multiple</span>
            </div>
            <div class="wl-pieces-chips" id="wlPiecesChips">
              <button type="button" class="wl-piece-chip is-selected" data-value="{{ look_1_title | escape }}" data-index="01">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">01 Archival Gown</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="{{ look_2_title | escape }}" data-index="02">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">02 Mirror Lehenga</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="{{ look_3_title | escape }}" data-index="03">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">03 Saree Gown</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="{{ look_4_title | escape }}" data-index="04">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">04 Botanical Set</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="{{ look_5_title | escape }}" data-index="05">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">05 Halter Gown</span>
              </button>
            </div>
            <input type="hidden" id="waitlistInterest" value="{{ look_1_title | escape }}">
          </div>

          <!-- Sizing -->
          <div class="wl-field">
            <label>Preferred Size</label>
            <div class="wl-size-row" role="radiogroup" aria-label="Preferred size">
              <button type="button" class="wl-size-pill" data-size="XS (UK 6)">XS</button>
              <button type="button" class="wl-size-pill" data-size="S (UK 8)">S</button>
              <button type="button" class="wl-size-pill is-selected" data-size="M (UK 10)">M</button>
              <button type="button" class="wl-size-pill" data-size="L (UK 12)">L</button>
              <button type="button" class="wl-size-pill" data-size="XL (UK 14)">XL</button>
            </div>
            <input type="hidden" id="waitlistPreferredSize" value="M (UK 10)">
          </div>

          <!-- Submit -->
          <button type="submit" class="wl-submit-btn" id="minimalSubmitBtn">
            {{ ws.submit_btn_text | default: 'Reserve Access' }} <span aria-hidden="true">→</span>
          </button>

          <p class="wl-privacy-note">{{ ws.disclaimer_text | default: 'Your details are kept private.' }}</p>

          <!-- Inline success state -->
          <div class="wl-success-inline" id="waitlistMinimalSuccess" style="display:none;">
            <div class="wl-success-icon">✦</div>
            <p class="wl-success-title">{{ ws.success_title | default: "You're on the list." }}</p>
            <p class="wl-success-sub" id="successSummaryText"></p>
          </div>
        </form>

        <!-- Hidden Shopify customer newsletter form for sync -->
        <form method="post" action="/contact#contact_form" id="shopifyNewsletterFallback" style="display:none;" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter, waitlist">
          <input type="email" name="contact[email]" value="">
        </form>
      </div>
    </section>
  </main>

  <!-- Luxury Modal Pop-up -->
  <div class="waitlist-success-modal" id="waitlistSuccessModal" role="dialog" aria-modal="true" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <button class="modal-close-btn" id="modalCloseBtn" aria-label="Close">✕</button>
      <span class="modal-sparkle">✦</span>
      <div class="modal-eyebrow">Teekhi Bella Atelier</div>
      <h3 class="modal-title">{{ ws.modal_heading | default: 'Reservation Confirmed' }}</h3>
      <div class="modal-divider"></div>
      <p id="modalSpotText" class="modal-desc">{{ ws.modal_subtext | default: 'Your spot for the Teekhi Bella collection is secured.' }}</p>
      <div class="modal-receipt-badge">VIP DROP ACCESS: ACTIVE</div>
      <button class="modal-action-btn" id="modalDoneBtn">Return to Store <span aria-hidden="true">→</span></button>
    </div>
  </div>
{%- endif -%}
</div>
