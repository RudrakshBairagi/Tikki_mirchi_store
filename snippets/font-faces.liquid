{%- comment -%}
  ════════════════════════════════════════════════════════════════════════
  SHARED FONT FACES — Ahsing, Ragara, Ragara Italic
  ════════════════════════════════════════════════════════════════════════
  Include this snippet anywhere custom brand fonts are needed:
    {% render 'font-faces' %}

  This replaces the duplicated @font-face blocks that were previously
  copy-pasted across 12+ Liquid files.
{%- endcomment -%}

<style>
  @font-face {
    font-family: 'Ahsing';
    src: url('{{ "Ahsing.woff" | asset_url }}') format('woff'),
         url('{{ "Ahsing.otf" | asset_url }}') format('opentype'),
         url('{{ "typogama-ahsing.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara-Italic.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara-Italic.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara-Italic.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Six Caps';
    src: url('{{ "SixCaps.ttf" | asset_url }}') format('truetype'),
         url('https://fonts.gstatic.com/s/sixcaps/v23/6ae_4KGrU7VR7bNmabcS.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>

<!-- Google Fonts Luxury Font Suite for Theme Customizer -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Italiana&family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
