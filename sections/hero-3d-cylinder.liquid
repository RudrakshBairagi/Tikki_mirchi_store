{{ 'header-morph.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-morph.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara-Italic.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara-Italic.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara-Italic.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  #HeroMasthead-{{ section.id }} {
    --hero-bg: {{ section.settings.bg_color | default: '#FF78F0' }};
    --hero-text: {{ section.settings.text_color | default: '#F5EA5A' }};
    --hero-title-color: {{ section.settings.title_color | default: '#F5EA5A' }};
  }

  .brand-morph-logo {
    font-family: 'Ragara', 'Italiana', Georgia, serif;
  }
{%- endstyle -%}

<!-- ==========================================================================
     TIKKI BELLA — LUXURY MORPHING HEADER (SOPHIE & LUCIE INSPIRED)
     ========================================================================== -->
<header id="LuxuryHeader" class="luxury-header">
  <div class="luxury-header__inner">
    <!-- Left Navigation & Menu Toggle -->
    <div class="luxury-header__left">
      <button class="header-action-btn menu-toggle" aria-label="Open menu" type="button">
        <span class="hamburger-icon">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="btn-label">MENU</span>
      </button>
      <nav class="desktop-nav">
        <a href="#atelier" class="nav-link">ATELIER</a>
        <a href="#runway" class="nav-link">RUNWAY</a>
        <a href="#collections" class="nav-link">COLLECTIONS</a>
      </nav>
    </div>

    <!-- Center Morphing Brand Zone -->
    <div class="luxury-header__center brand-morph-zone">
      <!-- Cursive Editorial Tagline (Visible at top, fades out on scroll) -->
      <div class="brand-tagline">
        {%- if section.settings.topbar_center != blank -%}
          {{ section.settings.topbar_center }}
        {%- else -%}
          Atelier Couture &amp; Ready-to-Wear
        {%- endif -%}
      </div>

      <!-- Morphing Brand Wordmark: Drops down into hero on load, merges back to navbar on scroll -->
      <a href="{{ routes.root_url }}" class="brand-morph-logo is-visible jump-in" id="BrandMorphLogo">
        <span class="brand-wordmark">{{ section.settings.heading | default: 'TIKKI Bella' }}</span>
      </a>
    </div>

    <!-- Right Action Icons (Proper High-Fashion Boutique Icons) -->
    <div class="luxury-header__right">
      <!-- Search -->
      <a href="{{ routes.search_url }}" class="header-action-btn" aria-label="Search" title="Search">
        <svg class="header-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <!-- Wishlist -->
      <button class="header-action-btn" aria-label="Wishlist" title="Wishlist" type="button">
        <svg class="header-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>
      <!-- Account -->
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header-action-btn" aria-label="Account" title="Account">
        <svg class="header-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <!-- Shopping Bag / Cart with live badge -->
      <a href="{{ routes.cart_url }}" class="header-action-btn cart-btn" aria-label="Shopping Bag" title="Shopping Bag">
        <svg class="header-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-count-badge">{{ cart.item_count | default: 0 }}</span>
      </a>
    </div>
  </div>
</header>

<!-- ==========================================================================
     EDITORIAL BRAND MASTHEAD (RUNWAY BACKDROP STAGE)
     ========================================================================== -->
<section
  id="HeroMasthead-{{ section.id }}"
  class="hero-editorial-masthead"
>
  <!-- Editorial Stage Sub-Meta Footer -->
  <div class="hero-editorial-footer">
    <div class="footer-tag">
      {%- if section.settings.topbar_left != blank -%}
        {{ section.settings.topbar_left }}
      {%- else -%}
        SPRING / SUMMER ATELIER 2026
      {%- endif -%}
    </div>
    <div class="footer-status">
      <span class="status-dot"></span>
      <span>{{ section.settings.topbar_right | default: 'RUNWAY LIVE' }}</span>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "3D Cylinder Hero",
  "tag": "section",
  "class": "section-hero-3d-cylinder",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cylinder",
      "label": "Show Rotating 3D Cylinder",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography & Branding"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Giant Background Title",
      "default": "TIKKI MIRCHI"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Title Accent (Italic)"
    },
    {
      "type": "text",
      "id": "topbar_left",
      "label": "Top Bar Left",
      "default": "TIKKI MIRCHI"
    },
    {
      "type": "text",
      "id": "topbar_center",
      "label": "Top Bar Center",
      "default": "ARTISANAL PANTRY • COLLECTION 2026"
    },
    {
      "type": "text",
      "id": "topbar_right",
      "label": "Top Bar Right",
      "default": "ALL NATURAL"
    },
    {
      "type": "header",
      "content": "Call To Action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0b0b0c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f5f2eb"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Giant Title Color",
      "default": "#f5f2eb"
    },
    {
      "type": "header",
      "content": "3D Physics & Visuals"
    },
    {
      "type": "range",
      "id": "auto_rotate_speed",
      "min": -30,
      "max": 30,
      "step": 2,
      "unit": "°/s",
      "label": "Auto-Rotation Speed",
      "default": 14
    },
    {
      "type": "range",
      "id": "tilt_angle",
      "min": -30,
      "max": 35,
      "step": 1,
      "unit": "°",
      "label": "Camera Tilt Angle",
      "default": 0
    },
    {
      "type": "range",
      "id": "perspective",
      "min": 600,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "3D Perspective Depth",
      "default": 1100
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 180,
      "max": 480,
      "step": 10,
      "unit": "px",
      "label": "Card Width (Desktop)",
      "default": 360
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Card Height (Desktop)",
      "default": 230
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Separation Gap",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_lighting",
      "label": "Enable Dynamic 3D Lighting & Shadows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_reflection",
      "label": "Enable Mirror Floor Reflection",
      "default": false
    },
    {
      "type": "range",
      "id": "reflection_opacity",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Floor Reflection Opacity",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Special Reserve"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Organic Harvest"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Edition 01"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3D Cylinder Hero (Kai Marlow)",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Kashmiri Saffron",
            "subtitle": "Artisanal Harvest",
            "tag": "Pure Grade A"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Fiery Guntur Chilli",
            "subtitle": "Sun-Dried Spice",
            "tag": "Signature Heat"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Roasted Cardamom",
            "subtitle": "Cold Smoked Pods",
            "tag": "Rare Pods"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Golden Turmeric",
            "subtitle": "Single Origin",
            "tag": "Potent Curcumin"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Crispy Tikki Blend",
            "subtitle": "Chef Reserve",
            "tag": "Street & Soul"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Tellicherry Peppercorn",
            "subtitle": "Black Pepper Pods",
            "tag": "Bold Crunch"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Star Anise Infusion",
            "subtitle": "Fragrant Botanicals",
            "tag": "Whole Spice"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Smoked Mirchi Oil",
            "subtitle": "Cold Pressed Extract",
            "tag": "Infused Reserve"
          }
        }
      ]
    }
  ]
}
{% endschema %}
