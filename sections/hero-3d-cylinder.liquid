            "tag": "Potent Curcumin"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Crispy Tikki Blend",
            "subtitle": "Chef Reserve",
            "tag": "Street & Soul"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Tellicherry Peppercorn",
            "subtitle": "Black Pepper Pods",
            "tag": "Bold Crunch"
          }
        },
        {
          "type": "card",
          "settings": {
