{%- render 'atelier-waitlist-content', section: section -%}

{% schema %}
{
  "name": "Atelier Waitlist",
  "tag": "section",
  "class": "section-atelier-waitlist",
  "settings": [
    {
      "type": "header",
      "content": "Brand & Header"
    },
    {
      "type": "text",
      "id": "header_logo_text",
      "label": "Header Brand / Logo Text",
      "default": "Teekhi Bella"
    },
    {
      "type": "select",
      "id": "logo_font_source",
      "label": "Header Logo Font Source",
      "options": [
        { "value": "ahsing", "label": "Ahsing (Typogama Couture)" },
        { "value": "ragara", "label": "Ragara (Couture Serif)" },
        { "value": "syne", "label": "Syne (Modern Luxury)" },
        { "value": "brand", "label": "Brand Default (Plus Jakarta Sans)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "ahsing"
    },
    {
      "type": "font_picker",
      "id": "logo_font",
      "label": "Logo Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected above."
    },
    {
      "type": "text",
      "id": "custom_logo_font",
      "label": "Custom Logo Font Name"
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "label": "Logo Font Size (px)",
      "min": 24,
      "max": 60,
      "step": 2,
      "default": 38
    },
    {
      "type": "header",
      "content": "Page Background & Appearance"
    },
    {
      "type": "select",
      "id": "bg_mode",
      "label": "Background Mode",
      "options": [
        { "value": "solid", "label": "Solid Color" },
        { "value": "gradient", "label": "Luxury Gradient" },
        { "value": "image", "label": "Background Image" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background Color",
      "default": "#f8f8f6"
    },
    {
      "type": "text",
      "id": "bg_gradient",
      "label": "Background Gradient (CSS)",
      "default": "linear-gradient(135deg, #f8f8f6 0%, #ece7dc 100%)",
      "info": "Active when Gradient mode is selected."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Active when Background Image mode is selected."
    },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Background Darken Overlay (%)",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 0
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Form Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading Typography"
    },
    {
      "type": "select",
      "id": "title_font_source",
      "label": "Main Heading Font Family",
      "options": [
        { "value": "brand", "label": "Brand Sans (Plus Jakarta Sans)" },
        { "value": "ahsing", "label": "Ahsing (Typogama Couture)" },
        { "value": "ragara", "label": "Ragara (Couture Serif)" },
        { "value": "syne", "label": "Syne (Modern Luxury Bold)" },
        { "value": "bodoni", "label": "Bodoni Moda (Editorial Vogue)" },
        { "value": "playfair", "label": "Playfair Display (Romantic Serif)" },
        { "value": "italiana", "label": "Italiana (Milano Couture)" },
        { "value": "cinzel", "label": "Cinzel (Grand Roman)" },
        { "value": "cormorant", "label": "Cormorant Garamond (Elegance)" },
        { "value": "outfit", "label": "Outfit (Ultra Clean Sans)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Google Font Name" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Heading Font (Shopify Library)",
      "default": "assistant_n4"
    },
    {
      "type": "text",
      "id": "custom_title_font",
      "label": "Custom Heading Font Name"
    },
    {
      "type": "range",
      "id": "title_scale",
      "label": "Heading Font Scale (%)",
      "min": 70,
      "max": 160,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Heading Letter Spacing (px)",
      "min": -2,
      "max": 16,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "Page Colors & Styling"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text Color",
      "default": "#1a1819"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Subtle / Helper Text Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold / Accent Color",
      "default": "#b38728"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card & Input Border Color",
      "default": "#e2e0da"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "Input Field Background",
      "default": "#fafaf8"
    },
    {
      "type": "color",
      "id": "submit_btn_bg",
      "label": "Submit Button Background",
      "default": "#1a1819"
    },
    {
      "type": "color",
      "id": "submit_btn_text",
      "label": "Submit Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Hero Header Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Summer Atelier 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading Title",
      "default": "Sign up to our waitlist!"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle Description",
      "default": "Complete the form below to reserve your bespoke piece from our exclusive runway drop."
    },
    {
      "type": "header",
      "content": "Step 1: Your Information Labels"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 Title",
      "default": "Your Information"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name Field Label",
      "default": "Full Name *"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name Field Placeholder",
      "default": "Enter your full name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Field Label",
      "default": "Email Address *"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Field Placeholder",
      "default": "name@example.com"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Field Label",
      "default": "Phone Number (WhatsApp VIP Access) *"
    },
    {
      "type": "text",
      "id": "phone_prefix",
      "label": "Phone Country Prefix",
      "default": "+91"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone Field Placeholder",
      "default": "98765 43210 (For WhatsApp drop access & VIP alerts)"
    },
    {
      "type": "text",
      "id": "city_label",
      "label": "City Field Label",
      "default": "City *"
    },
    {
      "type": "text",
      "id": "city_placeholder",
      "label": "City Field Placeholder",
      "default": "e.g. Mumbai / Delhi / Jaipur"
    },
    {
      "type": "text",
      "id": "state_label",
      "label": "State Field Label",
      "default": "State / UT *"
    },
    {
      "type": "text",
      "id": "pincode_label",
      "label": "PIN Code Field Label",
      "default": "PIN Code *"
    },
    {
      "type": "text",
      "id": "pincode_placeholder",
      "label": "PIN Code Placeholder",
      "default": "6 Digits (e.g. 400050)"
    },
    {
      "type": "header",
      "content": "Step 2: Dress Selection Labels"
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 Title",
      "default": "Select Your Desired Runway Dresses"
    },
    {
      "type": "text",
      "id": "step_2_subtitle",
      "label": "Step 2 Subtitle / Helper",
      "default": "Click on any dress tile to select or unselect. You can select multiple dresses."
    },
    {
      "type": "header",
      "content": "Step 3: Size & Reservation"
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Step 3 Title",
      "default": "Select Your Size"
    },
    {
      "type": "text",
      "id": "step_3_badge",
      "label": "Size Fit Badge",
      "default": "Indian Standard Couture Fit"
    },
    {
      "type": "text",
      "id": "custom_measurements_label",
      "label": "Custom Sizing Details Label",
      "default": "Custom Sizing Details (Optional):"
    },
    {
      "type": "text",
      "id": "custom_measurements_placeholder",
      "label": "Custom Sizing Placeholder",
      "default": "e.g. Bust 35, Waist 28, Hips 38, Height 5'6\""
    },
    {
      "type": "text",
      "id": "submit_btn_text",
      "label": "Submit Button Label",
      "default": "Submit Reservation"
    },
    {
      "type": "textarea",
      "id": "disclaimer_text",
      "label": "Privacy & VIP Disclaimer",
      "default": "By signing up, you agree to receive private collection drops & VIP runway access via WhatsApp / SMS. View our privacy policy and terms of service for more info."
    },
    {
      "type": "header",
      "content": "Confirmation / Success Screen"
    },
    {
      "type": "text",
      "id": "success_badge_text",
      "label": "Success Badge",
      "default": "✦ Reservation Confirmed ✦"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success Heading",
      "default": "You're on the exclusive waitlist!"
    },
    {
      "type": "textarea",
      "id": "success_desc",
      "label": "Success Description",
      "default": "Thank you for joining. When our private atelier drop opens, your VIP access link and priority checkout code will be dispatched directly to your WhatsApp and email."
    },
    {
      "type": "text",
      "id": "return_btn_text",
      "label": "Return Button Text",
      "default": "Return to Runway Rack"
    },
    {
      "type": "text",
      "id": "reserve_another_btn_text",
