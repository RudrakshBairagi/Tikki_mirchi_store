  "presets": [
    {
      "name": "Atelier Waitlist",
      "settings": {
        "eyebrow": "Summer Atelier 2026",
        "title": "Sign up to our waitlist!",
        "subtitle": "Complete the form below to reserve your bespoke piece from our exclusive runway drop.",
        "bg_color": "#f8f8f6"
      }
    }
  ]
