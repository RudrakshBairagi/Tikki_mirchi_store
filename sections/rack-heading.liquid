{%- style -%}
  @font-face {
    font-family: 'Ahsing';
    src: url('{{ "Ahsing.woff" | asset_url }}') format('woff'),
         url('{{ "Ahsing.otf" | asset_url }}') format('opentype'),
         url('{{ "typogama-ahsing.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  {%- if section.settings.font_source == 'shopify' and section.settings.font_picker != blank -%}
    {{ section.settings.font_picker | font_face: font_display: 'swap' }}
  {%- endif -%}

  #RackHeading-{{ section.id }} {
    {%- if section.settings.bg_transparent -%}
      background: transparent !important;
    {%- elsif section.settings.bg_mode == 'gradient' and section.settings.bg_gradient != blank -%}
      background: {{ section.settings.bg_gradient }} !important;
    {%- else -%}
      background-color: {{ section.settings.bg_color | default: '#FDDDED' }} !important;
    {%- endif -%}
    padding-top: {{ section.settings.padding_top | default: 6 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 8 }}px;
    text-align: {{ section.settings.text_alignment | default: 'center' }};
  }

  #RackHeading-{{ section.id }} .rack-heading-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #RackHeading-{{ section.id }} .rack-heading-title {
    {%- if section.settings.font_source == 'shopify' and section.settings.font_picker != blank -%}
      font-family: {{ section.settings.font_picker.family }}, {{ section.settings.font_picker.fallback_families }};
    {%- elsif section.settings.font_source == 'ahsing' -%}
      font-family: 'Ahsing', serif;
    {%- elsif section.settings.font_source == 'ragara' -%}
      font-family: 'Ragara', 'Italiana', Georgia, serif;
    {%- elsif section.settings.font_source == 'syne' -%}
      font-family: 'Syne', sans-serif;
    {%- elsif section.settings.font_source == 'bodoni' -%}
      font-family: 'Bodoni Moda', serif;
    {%- elsif section.settings.font_source == 'playfair' -%}
      font-family: 'Playfair Display', serif;
    {%- elsif section.settings.font_source == 'italiana' -%}
      font-family: 'Italiana', Georgia, serif;
    {%- elsif section.settings.font_source == 'cinzel' -%}
      font-family: 'Cinzel', serif;
    {%- elsif section.settings.font_source == 'cormorant' -%}
      font-family: 'Cormorant Garamond', serif;
    {%- elsif section.settings.font_source == 'outfit' -%}
      font-family: 'Outfit', sans-serif;
    {%- elsif section.settings.font_source == 'custom' and section.settings.custom_font != blank -%}
      font-family: '{{ section.settings.custom_font }}', serif;
    {%- else -%}
      font-family: 'Ahsing', serif;
    {%- endif -%}

    font-size: {{ section.settings.font_size_desktop | default: 48 }}px;
    font-weight: {{ section.settings.font_weight | default: 400 }};
    font-style: {{ section.settings.font_style | default: 'normal' }};
    letter-spacing: {{ section.settings.letter_spacing | default: 2 }}px;
    text-transform: {{ section.settings.text_transform | default: 'none' }};
    color: {{ section.settings.text_color | default: '#67574E' }};
    line-height: 1.15;
    margin: 0;
  }

  @media (max-width: 768px) {
    #RackHeading-{{ section.id }} .rack-heading-title {
      font-size: {{ section.settings.font_size_mobile | default: 34 }}px;
    }
  }
{%- endstyle -%}

<section id="RackHeading-{{ section.id }}" class="section-rack-heading" {{ section.shopify_attributes }}>
  <div class="rack-heading-container">
    {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
    <{{ heading_tag }} class="rack-heading-title">
      {{ section.settings.heading | default: 'Your Dream Rack' }}
    </{{ heading_tag }}>
  </div>
</section>

{% schema %}
{
  "name": "Rack Heading",
  "tag": "section",
  "class": "section-rack-heading-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Heading Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Your Dream Rack"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML Heading Tag",
      "options": [
        { "value": "h1", "label": "H1 (Primary)" },
        { "value": "h2", "label": "H2 (Secondary)" },
        { "value": "h3", "label": "H3 (Tertiary)" },
        { "value": "div", "label": "DIV (Standard)" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Typography & Font Design"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Font Family Source",
      "options": [
        { "value": "ahsing", "label": "Ahsing (Typogama Couture)" },
        { "value": "ragara", "label": "Ragara (Couture Serif)" },
        { "value": "syne", "label": "Syne (Modern Luxury)" },
        { "value": "bodoni", "label": "Bodoni Moda (Editorial Vogue)" },
        { "value": "playfair", "label": "Playfair Display (Romantic Serif)" },
        { "value": "italiana", "label": "Italiana (Milano Couture)" },
        { "value": "cinzel", "label": "Cinzel (Grand Roman)" },
        { "value": "cormorant", "label": "Cormorant Garamond (Elegance)" },
        { "value": "outfit", "label": "Outfit (Ultra Clean Sans)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "ahsing"
    },
    {
      "type": "font_picker",
      "id": "font_picker",
      "label": "Shopify Font Picker",
      "default": "gloock_n4",
      "info": "Active when 'Shopify Font Library' is selected above."
    },
    {
      "type": "text",
      "id": "custom_font",
      "label": "Custom Google Font Name",
      "info": "e.g. Cinzel Decorative, Italianno, Prata"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font Size Desktop (px)",
      "min": 24,
      "max": 100,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font Size Mobile (px)",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 34
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "300 (Light)" },
        { "value": "400", "label": "400 (Regular)" },
        { "value": "500", "label": "500 (Medium)" },
        { "value": "600", "label": "600 (Semi-Bold)" },
        { "value": "700", "label": "700 (Bold)" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "font_style",
      "label": "Font Style",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "italic", "label": "Italic" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter Spacing (px)",
      "min": -2,
      "max": 15,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Case",
      "options": [
        { "value": "none", "label": "Normal (As Typed)" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize Each Word" },
        { "value": "lowercase", "label": "lowercase" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#67574E"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDDDED"
    },
    {
      "type": "checkbox",
      "id": "bg_transparent",
      "label": "Transparent Background",
      "default": false
    },
    {
      "type": "select",
      "id": "bg_mode",
      "label": "Background Mode",
      "options": [
        { "value": "solid", "label": "Solid Color" },
        { "value": "gradient", "label": "CSS Gradient" }
      ],
      "default": "solid"
    },
    {
      "type": "text",
      "id": "bg_gradient",
      "label": "CSS Gradient",
      "default": "linear-gradient(135deg, #FDDDED 0%, #fbe8f2 100%)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Your Dream Rack (Heading)",
      "settings": {
        "heading": "Your Dream Rack",
        "font_source": "ahsing",
        "bg_color": "#FDDDED",
        "text_color": "#67574E"
      }
    }
  ]
}
{% endschema %}
