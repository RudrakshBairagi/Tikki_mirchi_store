{{ 'wardrobe-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wardrobe-carousel.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {%- if section.settings.heading_font_source == 'shopify' and section.settings.heading_font != blank -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'shopify' and section.settings.body_font != blank -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.card_font_source == 'shopify' and section.settings.card_font != blank -%}
    {{ section.settings.card_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #Wardrobe-{{ section.id }} {
    --wardrobe-bg: {{ section.settings.bg_color | default: '#f3f0e7' }};
    --wardrobe-text: {{ section.settings.text_color | default: '#2a2529' }};
    --wardrobe-accent: {{ section.settings.accent_color | default: '#c59b27' }};
    --wardrobe-dark: #1e1b1c;
    --wardrobe-card-bg: rgba(255, 255, 255, 0.94);

    {%- if section.settings.heading_font_source == 'shopify' and section.settings.heading_font != blank -%}
      --wardrobe-title-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --wardrobe-title-weight: {{ section.settings.heading_font.weight }};
      --wardrobe-title-style: {{ section.settings.heading_font.style }};
    {%- elsif section.settings.heading_font_source == 'custom' and section.settings.custom_heading_font != blank -%}
      --wardrobe-title-font: '{{ section.settings.custom_heading_font }}', serif;
      --wardrobe-title-weight: 400;
      --wardrobe-title-style: normal;
    {%- else -%}
      --wardrobe-title-font: 'Ragara', 'Italiana', Georgia, serif;
      --wardrobe-title-weight: 400;
      --wardrobe-title-style: normal;
    {%- endif -%}

    {%- if section.settings.body_font_source == 'shopify' and section.settings.body_font != blank -%}
      --wardrobe-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    {%- elsif section.settings.body_font_source == 'custom' and section.settings.custom_body_font != blank -%}
      --wardrobe-body-font: '{{ section.settings.custom_body_font }}', sans-serif;
    {%- else -%}
      --wardrobe-body-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    {%- endif -%}

    {%- if section.settings.card_font_source == 'shopify' and section.settings.card_font != blank -%}
      --wardrobe-card-font: {{ section.settings.card_font.family }}, {{ section.settings.card_font.fallback_families }};
    {%- elsif section.settings.card_font_source == 'custom' and section.settings.custom_card_font != blank -%}
      --wardrobe-card-font: '{{ section.settings.custom_card_font }}', sans-serif;
    {%- else -%}
      --wardrobe-card-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    {%- endif -%}

    --wardrobe-heading-scale: {{ section.settings.heading_font_scale | default: 100 | divided_by: 100.0 }};
    --wardrobe-body-scale: {{ section.settings.body_font_scale | default: 100 | divided_by: 100.0 }};
  }

  #Wardrobe-{{ section.id }} .magic-wardrobe-title {
    font-family: var(--wardrobe-title-font) !important;
    font-weight: var(--wardrobe-title-weight, 400) !important;
    font-style: var(--wardrobe-title-style, normal) !important;
    font-size: calc(clamp(30px, 4.5vw, 56px) * var(--wardrobe-heading-scale, 1)) !important;
  }

  #Wardrobe-{{ section.id }} .magic-wardrobe-subtitle,
  #Wardrobe-{{ section.id }} .magic-wardrobe-tagline,
  #Wardrobe-{{ section.id }} .magic-active-indicator,
  #Wardrobe-{{ section.id }} .magic-tab-btn {
    font-family: var(--wardrobe-body-font) !important;
  }

  #Wardrobe-{{ section.id }} .magic-wardrobe-subtitle {
    font-size: calc(15px * var(--wardrobe-body-scale, 1)) !important;
  }

  #Wardrobe-{{ section.id }} .card-title,
  #Wardrobe-{{ section.id }} .card-desc,
  #Wardrobe-{{ section.id }} .card-cta-btn,
  #Wardrobe-{{ section.id }} .card-tag,
  #Wardrobe-{{ section.id }} .card-badge {
    font-family: var(--wardrobe-card-font) !important;
  }
{%- endstyle -%}

<section
  id="Wardrobe-{{ section.id }}"
  class="magic-wardrobe-section"
  data-auto-cycle="{% if section.settings.auto_cycle %}true{% else %}false{% endif %}"
  data-speed="{{ section.settings.cycle_speed | default: 4 }}"
>
  <div class="magic-wardrobe-container">
    <!-- Header / Editorial Labeling -->
    <div class="magic-wardrobe-header">
      <div class="magic-wardrobe-tagline">
        <span class="magic-wardrobe-tag-dot">✦</span>
        <span>{{ section.settings.eyebrow | default: 'TEEKHI BELLA • THE MAGIC WARDROBE' }}</span>
      </div>
      <h2 class="magic-wardrobe-title">{{ section.settings.heading | default: 'THE ATELIER DRESSING ROOM' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="magic-wardrobe-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <!-- Dynamic Active Look Indicator -->
      <div class="magic-active-indicator" aria-live="polite">
        <span class="active-sparkle">✦</span>
        <span class="active-look-label">LOOK 01 OF 05</span>
        <span class="active-dot-separator">•</span>
        <span class="active-look-name">Golden Corset & Pearl Fringe Skirt</span>
      </div>
    </div>

    <!-- The Magic Wardrobe Portal Stage -->
    <div class="magic-wardrobe-stage">
      <!-- Previous Arrow -->
      <button type="button" class="magic-nav-btn nav-prev" aria-label="Previous outfit">
        <span aria-hidden="true">‹</span>
      </button>

      <!-- Central Wardrobe Frame with In-Place Cycling Outfits -->
      <div class="magic-wardrobe-stage-inner">
        <div class="magic-outfits-carousel">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- assign default_idx = forloop.index -%}
              {%- capture fallback_src -%}magic-wardrobe-look-{{ default_idx }}.jpg{%- endcapture -%}
              {%- assign outfit_src = fallback_src | asset_url -%}
              {%- if block.settings.image != blank -%}
                {%- assign outfit_src = block.settings.image | image_url: width: 900 -%}
              {%- endif -%}

              <div
                class="magic-outfit-slide {% if forloop.first %}is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-tag="{{ block.settings.tag | default: 'LOOK 01' }}"
                data-title="{{ block.settings.title | default: 'Partywear Outfit' }}"
                {{ block.shopify_attributes }}
              >
                <div class="magic-outfit-media">
                  <img
                    src="{{ outfit_src }}"
                    alt="{{ block.settings.title | default: 'Partywear Outfit' | escape }}"
                    class="magic-outfit-img"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="768"
                    height="1376"
                  >

                  {%- if block.settings.image != blank -%}
                    <!-- Overlay frame for user-uploaded custom images -->
                    <img
                      src="{{ 'magic-wardrobe-frame.png' | asset_url }}"
                      alt=""
                      class="magic-frame-overlay"
                      aria-hidden="true"
                    >
                  {%- endif -%}

                  <!-- Floating Outfit Action Tag -->
                  <div class="magic-outfit-details-card">
                    <div class="card-inner">
                      <div class="card-top-row">
                        <span class="card-tag">{{ block.settings.tag | default: 'LOOK 01' }}</span>
                        <span class="card-badge">DROP 01 EXCLUSIVE</span>
                      </div>
                      <h3 class="card-title">{{ block.settings.title | default: 'Partywear Look' }}</h3>
                      {%- if block.settings.details != blank -%}
                        <p class="card-desc">{{ block.settings.details }}</p>
                      {%- endif -%}
                      <a href="{{ block.settings.cta_link | default: '#waitlist' }}" class="card-cta-btn">
                        <span>{{ block.settings.cta_label | default: 'Join The Waitlist' }}</span>
                        <span class="btn-arrow">→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback 5 Default Looks if No Blocks Configured -->
            {%- for i in (1..5) -%}
              {%- capture fallback_src -%}magic-wardrobe-look-{{ i }}.jpg{%- endcapture -%}
              {%- case i -%}
                {%- when 1 -%}
                  {%- assign look_name = 'Golden Corset & Pearl Fringe Skirt' -%}
                  {%- assign look_desc = 'Sweetheart boned corset with intricate floral beading and pearl drop fringe.' -%}
                {%- when 2 -%}
                  {%- assign look_name = 'Emerald Velvet Crystal Corset Set' -%}
                  {%- assign look_desc = 'Rich emerald velvet bustier with crystal straps and side-slit mini skirt.' -%}
                {%- when 3 -%}
                  {%- assign look_name = 'Midnight Black Satin Bustier Dress' -%}
                  {%- assign look_desc = 'Sculpted boned corset dress with shimmering crystal rhinestone borders.' -%}
                {%- when 4 -%}
                  {%- assign look_name = 'Metallic Ruby Draped Halter Dress' -%}
                  {%- assign look_desc = 'Liquid metallic ruby silk with cowl neck draping and crystal choker collar.' -%}
                {%- when 5 -%}
                  {%- assign look_name = 'Champagne Pleated Corset Set' -%}
                  {%- assign look_desc = 'Silky satin sweetheart top with sparkling crystal fringe pleated skirt.' -%}
              {%- endcase -%}

              <div
                class="magic-outfit-slide {% if forloop.first %}is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-tag="LOOK 0{{ i }}"
                data-title="{{ look_name }}"
              >
                <div class="magic-outfit-media">
                  <img
                    src="{{ fallback_src | asset_url }}"
                    alt="{{ look_name }}"
                    class="magic-outfit-img"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="768"
                    height="1376"
                  >
                  <div class="magic-outfit-details-card">
                    <div class="card-inner">
                      <div class="card-top-row">
                        <span class="card-tag">LOOK 0{{ i }}</span>
                        <span class="card-badge">DROP 01 EXCLUSIVE</span>
                      </div>
                      <h3 class="card-title">{{ look_name }}</h3>
                      <p class="card-desc">{{ look_desc }}</p>
                      <a href="#waitlist" class="card-cta-btn">
                        <span>Join The Waitlist</span>
                        <span class="btn-arrow">→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- Next Arrow -->
      <button type="button" class="magic-nav-btn nav-next" aria-label="Next outfit">
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <!-- Bottom Look Switcher Tabs -->
    <div class="magic-selector-bar" role="tablist" aria-label="Select outfit look">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="magic-selector-tab {% if forloop.first %}is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="tab-index">0{{ forloop.index }}</span>
            <span class="tab-title">{{ block.settings.title | split: '&' | first | strip }}</span>
          </button>
        {%- endfor -%}
      {%- else -%}
        <button type="button" class="magic-selector-tab is-active" data-index="0" role="tab" aria-selected="true">
          <span class="tab-index">01</span><span class="tab-title">Golden Corset</span>
        </button>
        <button type="button" class="magic-selector-tab" data-index="1" role="tab" aria-selected="false">
          <span class="tab-index">02</span><span class="tab-title">Emerald Velvet</span>
        </button>
        <button type="button" class="magic-selector-tab" data-index="2" role="tab" aria-selected="false">
          <span class="tab-index">03</span><span class="tab-title">Midnight Satin</span>
        </button>
        <button type="button" class="magic-selector-tab" data-index="3" role="tab" aria-selected="false">
          <span class="tab-index">04</span><span class="tab-title">Metallic Ruby</span>
        </button>
        <button type="button" class="magic-selector-tab" data-index="4" role="tab" aria-selected="false">
          <span class="tab-index">05</span><span class="tab-title">Champagne Pleated</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Magic Wardrobe Lookbook",
  "tag": "section",
  "class": "section-magic-wardrobe",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Tag",
      "default": "TEEKHI BELLA • THE MAGIC WARDROBE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE ATELIER DRESSING ROOM"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Step inside our private dressing room. Watch our debut partywear collection come to life."
    },
    {
      "type": "header",
      "content": "Typography & Font Styling"
    },
    {
      "type": "select",
      "id": "heading_font_source",
      "label": "Heading Font Source",
      "options": [
        { "value": "brand", "label": "Brand Default (Ragara Couture)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name (e.g. Google Font)" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_heading_font",
      "label": "Custom Heading Font Name",
      "info": "E.g. Playfair Display, Cinzel, Italiana, Bodoni Moda"
    },
    {
      "type": "range",
      "id": "heading_font_scale",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading Font Size Scale",
      "default": 100
    },
    {
      "type": "select",
      "id": "body_font_source",
      "label": "Subtitle & Tagline Font Source",
      "options": [
        { "value": "brand", "label": "Theme Default" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Subtitle & Tagline Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_body_font",
      "label": "Custom Subtitle Font Name"
    },
    {
      "type": "range",
      "id": "body_font_scale",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Subtitle Font Size Scale",
      "default": 100
    },
    {
      "type": "select",
      "id": "card_font_source",
      "label": "Outfit Card Font Source",
      "options": [
        { "value": "brand", "label": "Theme Default" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "card_font",
      "label": "Outfit Card Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_card_font",
      "label": "Custom Outfit Card Font Name"
    },
    {
      "type": "header",
      "content": "Carousel Interactive Controls"
    },
    {
      "type": "checkbox",
      "id": "auto_cycle",
      "label": "Enable Auto Slide Cycling",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Cycle Speed (seconds)",
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f3f0e7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2a2529"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#c59b27"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Outfit Look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Outfit Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "LOOK 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Outfit Name",
          "default": "Partywear Outfit"
        },
        {
          "type": "textarea",
          "id": "details",
          "label": "Outfit Details",
          "default": "Luxury bespoke partywear design"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "Join The Waitlist"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Magic Wardrobe Lookbook",
      "blocks": [
        { "type": "look", "settings": { "tag": "LOOK 01", "title": "Golden Corset & Pearl Fringe Skirt", "details": "Sweetheart boned corset with intricate floral beading and pearl drop fringe." } },
        { "type": "look", "settings": { "tag": "LOOK 02", "title": "Emerald Velvet Crystal Corset Set", "details": "Rich emerald velvet bustier with crystal straps and side-slit mini skirt." } },
        { "type": "look", "settings": { "tag": "LOOK 03", "title": "Midnight Black Satin Bustier Dress", "details": "Sculpted boned corset dress with shimmering crystal rhinestone borders." } },
        { "type": "look", "settings": { "tag": "LOOK 04", "title": "Metallic Ruby Draped Halter Dress", "details": "Liquid metallic ruby silk with cowl neck draping and crystal choker collar." } },
        { "type": "look", "settings": { "tag": "LOOK 05", "title": "Champagne Pleated Corset Set", "details": "Silky satin sweetheart top with sparkling crystal fringe pleated skirt." } }
      ]
    }
  ]
}
{% endschema %}
