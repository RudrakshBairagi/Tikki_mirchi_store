{{ 'header-morph.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-morph.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara-Italic.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara-Italic.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara-Italic.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Ahsing';
    src: url('{{ "Ahsing.woff" | asset_url }}') format('woff'),
         url('{{ "Ahsing.otf" | asset_url }}') format('opentype'),
         url('{{ "typogama-ahsing.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  {%- if section.settings.logo_font_source == 'shopify' and section.settings.logo_font != blank -%}
    {{ section.settings.logo_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.tagline_font_source == 'shopify' and section.settings.tagline_font != blank -%}
    {{ section.settings.tagline_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.nav_font_source == 'shopify' and section.settings.nav_font != blank -%}
    {{ section.settings.nav_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #LuxuryHeaderSection-{{ section.id }} {
    --hero-bg: {{ section.settings.bg_color | default: 'transparent' }};
    --hero-text: {{ section.settings.text_color | default: '#161517' }};
    --hero-title-color: {{ section.settings.title_color | default: '#161517' }};
    --docked-text-color: {{ section.settings.docked_text_color | default: '#161517' }};
    --docked-bg-color: {{ section.settings.docked_bg_color | default: '#f8f8f6' }};

    {%- if section.settings.logo_font_source == 'shopify' and section.settings.logo_font != blank -%}
      --header-logo-font: {{ section.settings.logo_font.family }}, {{ section.settings.logo_font.fallback_families }};
      --header-logo-weight: {{ section.settings.logo_font.weight }};
      --header-logo-style: {{ section.settings.logo_font.style }};
    {%- elsif section.settings.logo_font_source == 'ahsing' -%}
      --header-logo-font: 'Ahsing', serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'ragara' or section.settings.logo_font_source == 'brand' -%}
      --header-logo-font: 'Ragara', 'Italiana', Georgia, serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'syne' -%}
      --header-logo-font: 'Syne', sans-serif;
      --header-logo-weight: 700;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'bodoni' -%}
      --header-logo-font: 'Bodoni Moda', serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'playfair' -%}
      --header-logo-font: 'Playfair Display', serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'italiana' -%}
      --header-logo-font: 'Italiana', Georgia, serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'cinzel' -%}
      --header-logo-font: 'Cinzel', serif;
      --header-logo-weight: 600;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'cormorant' -%}
      --header-logo-font: 'Cormorant Garamond', serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'outfit' -%}
      --header-logo-font: 'Outfit', sans-serif;
      --header-logo-weight: 500;
      --header-logo-style: normal;
    {%- elsif section.settings.logo_font_source == 'custom' and section.settings.custom_logo_font != blank -%}
      --header-logo-font: '{{ section.settings.custom_logo_font }}', serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- else -%}
      --header-logo-font: 'Ahsing', serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- endif -%}

    {%- if section.settings.tagline_font_source == 'shopify' and section.settings.tagline_font != blank -%}
      --header-tagline-font: {{ section.settings.tagline_font.family }}, {{ section.settings.tagline_font.fallback_families }};
      --header-tagline-weight: {{ section.settings.tagline_font.weight }};
      --header-tagline-style: {{ section.settings.tagline_font.style }};
    {%- elsif section.settings.tagline_font_source == 'ahsing' -%}
      --header-tagline-font: 'Ahsing', serif;
      --header-tagline-weight: 400;
      --header-tagline-style: normal;
    {%- elsif section.settings.tagline_font_source == 'custom' and section.settings.custom_tagline_font != blank -%}
      --header-tagline-font: '{{ section.settings.custom_tagline_font }}', serif;
      --header-tagline-weight: 400;
      --header-tagline-style: italic;
    {%- else -%}
      --header-tagline-font: 'Italiana', Georgia, serif;
      --header-tagline-weight: 400;
      --header-tagline-style: italic;
    {%- endif -%}

    {%- if section.settings.nav_font_source == 'shopify' and section.settings.nav_font != blank -%}
      --header-nav-font: {{ section.settings.nav_font.family }}, {{ section.settings.nav_font.fallback_families }};
      --header-nav-weight: {{ section.settings.nav_font.weight }};
    {%- elsif section.settings.nav_font_source == 'ahsing' -%}
      --header-nav-font: 'Ahsing', serif;
      --header-nav-weight: 400;
    {%- elsif section.settings.nav_font_source == 'custom' and section.settings.custom_nav_font != blank -%}
      --header-nav-font: '{{ section.settings.custom_nav_font }}', sans-serif;
      --header-nav-weight: 600;
    {%- else -%}
      --header-nav-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --header-nav-weight: 600;
    {%- endif -%}

    --header-logo-scale: {{ section.settings.logo_font_scale | default: 100 | divided_by: 100.0 }};
    --header-tagline-scale: {{ section.settings.tagline_font_scale | default: 100 | divided_by: 100.0 }};
    --header-nav-scale: {{ section.settings.nav_font_scale | default: 100 | divided_by: 100.0 }};
    --header-logo-spacing: {{ section.settings.logo_letter_spacing | default: 0.02 }}em;
  }

  #LuxuryHeaderSection-{{ section.id }} .hero-editorial-masthead {
    background-color: var(--hero-bg) !important;
  }

  #LuxuryHeaderSection-{{ section.id }} #LuxuryHeader {
    {%- if section.settings.bg_mode == 'gradient' and section.settings.bg_gradient != blank -%}
      background: {{ section.settings.bg_gradient }} !important;
    {%- elsif section.settings.docked_bg_color != blank -%}
      background-color: var(--docked-bg-color) !important;
    {%- endif -%}
    backdrop-filter: blur({{ section.settings.backdrop_blur | default: 12 }}px) !important;
    -webkit-backdrop-filter: blur({{ section.settings.backdrop_blur | default: 12 }}px) !important;
  }

  #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo {
    font-family: var(--header-logo-font) !important;
    font-weight: var(--header-logo-weight, 400) !important;
    font-style: var(--header-logo-style, normal) !important;
    font-size: calc(clamp(2.2rem, 3.2vw, 3rem) * var(--header-logo-scale, 1)) !important;
    letter-spacing: var(--header-logo-spacing, 0.02em) !important;
  }

  @media (max-width: 768px) {
    #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo {
      font-size: calc(clamp(2.35rem, 7.8vw, 3.1rem) * var(--header-logo-scale, 1)) !important;
      line-height: 0.95 !important;
    }
    #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo .brand-wordmark {
      font-size: inherit !important;
      line-height: 0.95 !important;
    }
  }

  @media (max-width: 480px) {
    #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo {
      font-size: calc(clamp(2.25rem, 8.2vw, 2.85rem) * var(--header-logo-scale, 1)) !important;
      line-height: 0.95 !important;
    }
    #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo .brand-wordmark {
      font-size: inherit !important;
      line-height: 0.95 !important;
    }
  }

  #LuxuryHeaderSection-{{ section.id }} .brand-tagline {
    font-family: var(--header-tagline-font) !important;
    font-weight: var(--header-tagline-weight, 400) !important;
    font-style: var(--header-tagline-style, italic) !important;
    font-size: calc(clamp(13px, 1.35vw, 16px) * var(--header-tagline-scale, 1)) !important;
  }

  #LuxuryHeaderSection-{{ section.id }} .luxury-header,
  #LuxuryHeaderSection-{{ section.id }} .nav-link,
  #LuxuryHeaderSection-{{ section.id }} .btn-label {
    font-family: var(--header-nav-font) !important;
  }

  #LuxuryHeaderSection-{{ section.id }} .nav-link,
  #LuxuryHeaderSection-{{ section.id }} .btn-label {
    font-size: calc(12px * var(--header-nav-scale, 1)) !important;
  }

  @media (max-width: 768px) {
    #LuxuryHeaderSection-{{ section.id }} .nav-link,
    #LuxuryHeaderSection-{{ section.id }} .btn-label {
      font-size: clamp(9.5px, 2.5vw, 10.5px) !important;
      letter-spacing: 0.08em !important;
    }
  }

  @media (max-width: 480px) {
    #LuxuryHeaderSection-{{ section.id }} .nav-link,
    #LuxuryHeaderSection-{{ section.id }} .btn-label {
      font-size: 9px !important;
      letter-spacing: 0.06em !important;
    }
  }
{%- endstyle -%}

{%- liquid
  assign is_home = false
  if request.page_type == 'index' or template.name == 'index'
    assign is_home = true
  endif

  assign is_waitlist = false
  if request.path contains 'waitlist' or template.suffix == 'waitlist' or page.handle == 'waitlist'
    assign is_waitlist = true
  endif
-%}

<div id="LuxuryHeaderSection-{{ section.id }}" class="luxury-header-section-wrapper">
  <!-- ==========================================================================
       1. LUXURY NAVIGATION BAR (UNIFIED ACROSS ALL STORE PAGES)
       ========================================================================== -->
  <header id="LuxuryHeader" class="luxury-header scrolled-down">
    <div class="luxury-header__inner">
      <!-- Left: Navigation Links (Dropdown on Mobile + Direct Links on Desktop) -->
      <div class="luxury-header__left">
        <!-- Mobile Menu Dropdown Wrapper (Visible on Phone) -->
        <div class="menu-dropdown-wrapper">
          <button class="header-action-btn menu-toggle" id="HeaderMenuToggle" aria-label="Toggle Navigation Menu" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="LuxuryMenuDropdown">
            <span class="hamburger-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="btn-label">{{ section.settings.menu_toggle_label | default: 'MENU' }}</span>
          </button>

          <!-- Luxury Dropdown Menu -->
          <div id="LuxuryMenuDropdown" class="luxury-menu-dropdown" role="menu" aria-label="Navigation Menu" aria-hidden="true">
            <a href="{{ section.settings.link_1_url | default: routes.root_url }}" class="dropdown-nav-link dropdown-link-home{% if is_home %} is-active{% endif %}" role="menuitem">
              <span class="dropdown-link-label">{{ section.settings.link_1_label | default: 'HOME' }}</span>
              <span class="dropdown-link-arrow">⟶</span>
            </a>
            <div class="dropdown-nav-divider"></div>
            <a href="{{ section.settings.link_2_url | default: '/pages/waitlist' }}" class="dropdown-nav-link dropdown-link-waitlist{% if is_waitlist %} is-active{% endif %}" role="menuitem">
              <span class="dropdown-link-label">{{ section.settings.link_2_label | default: 'WAITLIST ✦' }}</span>
              <span class="dropdown-link-arrow">⟶</span>
            </a>
          </div>
        </div>

        <!-- Desktop Navigation (Visible on Desktop) -->
        <nav class="desktop-nav" aria-label="Primary Navigation">
          <a href="{{ section.settings.link_1_url | default: routes.root_url }}" class="nav-link header-nav-home{% if is_home %} is-active{% endif %}">{{ section.settings.link_1_label | default: 'HOME' }}</a>
          <a href="{{ section.settings.link_2_url | default: '/pages/waitlist' }}" class="nav-link header-nav-waitlist{% if is_waitlist %} is-active{% endif %}">{{ section.settings.link_2_label | default: 'WAITLIST ✦' }}</a>
        </nav>
      </div>

      <!-- Center: Morph Dock Anchor (Brand Logo Centered in Middle) -->
      <div class="luxury-header__center brand-morph-zone">
        <a href="{{ routes.root_url }}" class="brand-morph-logo is-visible" id="BrandMorphLogo" aria-label="{{ section.settings.heading | default: 'Teekhi Bella' }}">
          <span class="brand-wordmark">{{ section.settings.heading | default: 'Teekhi Bella' }}</span>
        </a>
      </div>

      <!-- Right: Utility Actions (Search & Cart) -->
      <div class="luxury-header__right">
        {%- if section.settings.show_search != false -%}
          <a href="{{ routes.search_url }}" class="header-action-btn search-toggle-btn" aria-label="Search" title="{{ section.settings.search_placeholder | default: 'Search' }}">
            <svg class="search-icon-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.show_cart != false -%}
          <a href="{{ routes.cart_url }}" class="header-action-btn cart-btn" aria-label="Cart">
            <svg class="cart-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="cart-count-badge" id="CartCountBadge">{{ cart.item_count | default: 0 }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </header>
  <div class="luxury-header-spacer" aria-hidden="true"></div>
</div>

{% schema %}
{
  "name": "Luxury Morphing Header",
  "tag": "section",
  "class": "section-luxury-header",
  "settings": [
    {
      "type": "header",
      "content": "Brand Typography & Title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Brand Title",
      "default": "Teekhi Bella"
    },
    {
      "type": "select",
      "id": "logo_font_source",
      "label": "Brand Logo Font Source",
      "options": [
        { "value": "ahsing", "label": "Ahsing (Typogama Couture)" },
        { "value": "brand", "label": "Ragara Couture (Classic)" },
        { "value": "ragara", "label": "Ragara (Couture Serif)" },
        { "value": "syne", "label": "Syne (Modern Luxury Bold)" },
        { "value": "bodoni", "label": "Bodoni Moda (Editorial Vogue)" },
        { "value": "playfair", "label": "Playfair Display (Romantic Serif)" },
        { "value": "italiana", "label": "Italiana (Milano Couture)" },
        { "value": "cinzel", "label": "Cinzel (Grand Roman)" },
        { "value": "cormorant", "label": "Cormorant Garamond (Elegance)" },
        { "value": "outfit", "label": "Outfit (Ultra Clean Sans)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name (e.g. Google Font)" }
      ],
      "default": "ahsing"
    },
    {
      "type": "font_picker",
      "id": "logo_font",
      "label": "Logo Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_logo_font",
      "label": "Custom Logo Font Name",
      "info": "Active when 'Custom Font Name' is selected (e.g. Playfair Display, Cinzel, Italiana)."
    },
    {
      "type": "range",
      "id": "logo_font_scale",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Logo Font Size Scale",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_letter_spacing",
      "min": -2,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Logo Letter Spacing",
      "default": 1
    },
    {
      "type": "header",
      "content": "Editorial Tagline Typography"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Editorial Tagline (Cursive)",
      "default": "Atelier Couture & Ready-to-Wear"
    },
    {
      "type": "select",
      "id": "tagline_font_source",
      "label": "Tagline Font Source",
      "options": [
        { "value": "ahsing", "label": "Ahsing (Typogama Couture)" },
        { "value": "brand", "label": "Brand Default (Italiana Serif)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "tagline_font",
      "label": "Tagline Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_tagline_font",
      "label": "Custom Tagline Font Name"
    },
    {
      "type": "range",
      "id": "tagline_font_scale",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Tagline Font Size Scale",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation Typography"
    },
    {
      "type": "select",
      "id": "nav_font_source",
      "label": "Navigation Font Source",
      "options": [
        { "value": "ahsing", "label": "Ahsing (Typogama Couture)" },
        { "value": "brand", "label": "Brand Default (Plus Jakarta Sans)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "nav_font",
      "label": "Navigation Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_nav_font",
      "label": "Custom Navigation Font Name"
    },
    {
      "type": "range",
      "id": "nav_font_scale",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Navigation Font Size Scale",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation Links & Menu"
    },
    {
      "type": "text",
      "id": "menu_toggle_label",
      "label": "Mobile Menu Button Label",
      "default": "MENU"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Link 1 Label (Home)",
      "default": "HOME"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Link 2 Label (Waitlist)",
      "default": "WAITLIST ✦"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "header",
      "content": "Utility Actions (Search & Cart)"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Enable Search Icon & Input",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Input Placeholder",
      "default": "Search atelier couture, gowns, lehengas..."
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Enable Cart Icon & Badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "select",
      "id": "bg_mode",
      "label": "Navbar Background Mode",
      "options": [
        { "value": "solid", "label": "Solid Color" },
        { "value": "gradient", "label": "Luxury Gradient" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "docked_bg_color",
      "label": "Docked Navbar Background Color",
      "default": "#f8f8f6"
    },
    {
      "type": "text",
      "id": "bg_gradient",
      "label": "Docked Navbar Background Gradient (CSS)",
      "default": "linear-gradient(135deg, rgba(248, 248, 246, 0.95) 0%, rgba(238, 234, 226, 0.92) 100%)"
    },
    {
      "type": "range",
      "id": "backdrop_blur",
      "label": "Glassmorphism Backdrop Blur (px)",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Hero Masthead Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Hero Text & Icon Color",
      "default": "#161517"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Hero Title Color",
      "default": "#161517"
    },
    {
      "type": "color",
      "id": "docked_text_color",
      "label": "Docked Navbar Text & Icon Color",
      "default": "#161517"
    }
  ],
  "presets": [
    {
      "name": "Luxury Morphing Header"
    }
  ]
}
{% endschema %}
