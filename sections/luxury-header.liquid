{{ 'header-morph.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-morph.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Ragara';
    src: url('{{ "Ragara-Italic.woff" | asset_url }}') format('woff'),
         url('{{ "Ragara-Italic.otf" | asset_url }}') format('opentype'),
         url('{{ "Ragara-Italic.ttf" | asset_url }}') format('truetype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  {%- if section.settings.logo_font_source == 'shopify' and section.settings.logo_font != blank -%}
    {{ section.settings.logo_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.tagline_font_source == 'shopify' and section.settings.tagline_font != blank -%}
    {{ section.settings.tagline_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.nav_font_source == 'shopify' and section.settings.nav_font != blank -%}
    {{ section.settings.nav_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #LuxuryHeaderSection-{{ section.id }} {
    --hero-bg: {{ section.settings.bg_color | default: 'transparent' }};
    --hero-text: {{ section.settings.text_color | default: '#161517' }};
    --hero-title-color: {{ section.settings.title_color | default: '#161517' }};
    --docked-text-color: {{ section.settings.docked_text_color | default: '#161517' }};
    --docked-bg-color: {{ section.settings.docked_bg_color | default: '#f8f8f6' }};

    {%- if section.settings.logo_font_source == 'shopify' and section.settings.logo_font != blank -%}
      --header-logo-font: {{ section.settings.logo_font.family }}, {{ section.settings.logo_font.fallback_families }};
      --header-logo-weight: {{ section.settings.logo_font.weight }};
      --header-logo-style: {{ section.settings.logo_font.style }};
    {%- elsif section.settings.logo_font_source == 'custom' and section.settings.custom_logo_font != blank -%}
      --header-logo-font: '{{ section.settings.custom_logo_font }}', serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- else -%}
      --header-logo-font: 'Ragara', 'Italiana', Georgia, serif;
      --header-logo-weight: 400;
      --header-logo-style: normal;
    {%- endif -%}

    {%- if section.settings.tagline_font_source == 'shopify' and section.settings.tagline_font != blank -%}
      --header-tagline-font: {{ section.settings.tagline_font.family }}, {{ section.settings.tagline_font.fallback_families }};
      --header-tagline-weight: {{ section.settings.tagline_font.weight }};
      --header-tagline-style: {{ section.settings.tagline_font.style }};
    {%- elsif section.settings.tagline_font_source == 'custom' and section.settings.custom_tagline_font != blank -%}
      --header-tagline-font: '{{ section.settings.custom_tagline_font }}', serif;
      --header-tagline-weight: 400;
      --header-tagline-style: italic;
    {%- else -%}
      --header-tagline-font: 'Italiana', Georgia, serif;
      --header-tagline-weight: 400;
      --header-tagline-style: italic;
    {%- endif -%}

    {%- if section.settings.nav_font_source == 'shopify' and section.settings.nav_font != blank -%}
      --header-nav-font: {{ section.settings.nav_font.family }}, {{ section.settings.nav_font.fallback_families }};
      --header-nav-weight: {{ section.settings.nav_font.weight }};
    {%- elsif section.settings.nav_font_source == 'custom' and section.settings.custom_nav_font != blank -%}
      --header-nav-font: '{{ section.settings.custom_nav_font }}', sans-serif;
      --header-nav-weight: 600;
    {%- else -%}
      --header-nav-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --header-nav-weight: 600;
    {%- endif -%}

    --header-logo-scale: {{ section.settings.logo_font_scale | default: 100 | divided_by: 100.0 }};
    --header-tagline-scale: {{ section.settings.tagline_font_scale | default: 100 | divided_by: 100.0 }};
    --header-nav-scale: {{ section.settings.nav_font_scale | default: 100 | divided_by: 100.0 }};
  }

  #LuxuryHeaderSection-{{ section.id }} .hero-editorial-masthead {
    background-color: var(--hero-bg) !important;
  }

  #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo {
    font-family: var(--header-logo-font) !important;
    font-weight: var(--header-logo-weight, 400) !important;
    font-style: var(--header-logo-style, normal) !important;
    font-size: calc(clamp(2.2rem, 3.2vw, 3rem) * var(--header-logo-scale, 1)) !important;
  }

  @media (max-width: 768px) {
    #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo {
      font-size: calc(clamp(1.45rem, 5.2vw, 1.85rem) * var(--header-logo-scale, 1)) !important;
    }
  }

  @media (max-width: 480px) {
    #LuxuryHeaderSection-{{ section.id }} .brand-morph-logo {
      font-size: calc(1.4rem * var(--header-logo-scale, 1)) !important;
    }
  }

  #LuxuryHeaderSection-{{ section.id }} .brand-tagline {
    font-family: var(--header-tagline-font) !important;
    font-weight: var(--header-tagline-weight, 400) !important;
    font-style: var(--header-tagline-style, italic) !important;
    font-size: calc(clamp(13px, 1.35vw, 16px) * var(--header-tagline-scale, 1)) !important;
  }

  #LuxuryHeaderSection-{{ section.id }} .luxury-header,
  #LuxuryHeaderSection-{{ section.id }} .nav-link,
  #LuxuryHeaderSection-{{ section.id }} .btn-label {
    font-family: var(--header-nav-font) !important;
  }

  #LuxuryHeaderSection-{{ section.id }} .nav-link,
  #LuxuryHeaderSection-{{ section.id }} .btn-label {
    font-size: calc(12px * var(--header-nav-scale, 1)) !important;
  }

  @media (max-width: 768px) {
    #LuxuryHeaderSection-{{ section.id }} .nav-link,
    #LuxuryHeaderSection-{{ section.id }} .btn-label {
      font-size: clamp(9.5px, 2.5vw, 10.5px) !important;
      letter-spacing: 0.08em !important;
    }
  }

  @media (max-width: 480px) {
    #LuxuryHeaderSection-{{ section.id }} .nav-link,
    #LuxuryHeaderSection-{{ section.id }} .btn-label {
      font-size: 9px !important;
      letter-spacing: 0.06em !important;
    }
  }
{%- endstyle -%}

<div id="LuxuryHeaderSection-{{ section.id }}" class="luxury-header-section-wrapper">
  <!-- ==========================================================================
       1. LUXURY NAVIGATION BAR (SOPHIE & LUCIE INSPIRED)
       ========================================================================== -->
  <header id="LuxuryHeader" class="luxury-header scrolled-down">
    <div class="luxury-header__inner">
      <!-- Left: Navigation Links (Homepage + Waitlist) -->
      <div class="luxury-header__left">
        <nav class="desktop-nav" aria-label="Primary Navigation">
          <a href="{{ section.settings.link_1_url | default: routes.root_url }}" class="nav-link header-nav-home">{{ section.settings.link_1_label | default: 'HOME' }}</a>
          <a href="{{ section.settings.link_2_url | default: '/pages/waitlist' }}" class="nav-link header-nav-waitlist" style="color: #b38728; font-weight: 600;">{{ section.settings.link_2_label | default: 'WAITLIST ✦' }}</a>
        </nav>
      </div>

      <!-- Center: Morph Dock Anchor (Brand Logo Centered in Middle) -->
      <div class="luxury-header__center brand-morph-zone">
        <a href="{{ routes.root_url }}" class="brand-morph-logo is-visible" id="BrandMorphLogo" aria-label="{{ section.settings.heading | default: 'Teekhi Bella' }}">
          <span class="brand-wordmark">{{ section.settings.heading | default: 'Teekhi Bella' }}</span>
        </a>
      </div>

      <!-- Right: Clean Minimal Zone (Utility icons removed) -->
      <div class="luxury-header__right" aria-hidden="true"></div>
    </div>
  </header>
  <div class="luxury-header-spacer" aria-hidden="true"></div>
</div>

{% schema %}
{
  "name": "Luxury Morphing Header",
  "tag": "section",
  "class": "section-luxury-header",
  "settings": [
    {
      "type": "header",
      "content": "Brand Typography & Title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Brand Title",
      "default": "Teekhi Bella"
    },
    {
      "type": "select",
      "id": "logo_font_source",
      "label": "Brand Logo Font Source",
      "options": [
        { "value": "brand", "label": "Brand Default (Ragara Couture)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name (e.g. Google Font)" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "logo_font",
      "label": "Logo Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_logo_font",
      "label": "Custom Logo Font Name",
      "info": "Active when 'Custom Font Name' is selected (e.g. Playfair Display, Cinzel, Italiana)."
    },
    {
      "type": "range",
      "id": "logo_font_scale",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Logo Font Size Scale",
      "default": 100
    },
    {
      "type": "header",
      "content": "Editorial Tagline Typography"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Editorial Tagline (Cursive)",
      "default": "Atelier Couture & Ready-to-Wear"
    },
    {
      "type": "select",
      "id": "tagline_font_source",
      "label": "Tagline Font Source",
      "options": [
        { "value": "brand", "label": "Brand Default (Italiana Serif)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "tagline_font",
      "label": "Tagline Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_tagline_font",
      "label": "Custom Tagline Font Name"
    },
    {
      "type": "range",
      "id": "tagline_font_scale",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Tagline Font Size Scale",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation Typography"
    },
    {
      "type": "select",
      "id": "nav_font_source",
      "label": "Navigation Font Source",
      "options": [
        { "value": "brand", "label": "Brand Default (Plus Jakarta Sans)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "brand"
    },
    {
      "type": "font_picker",
      "id": "nav_font",
      "label": "Navigation Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected."
    },
    {
      "type": "text",
      "id": "custom_nav_font",
      "label": "Custom Navigation Font Name"
    },
    {
      "type": "range",
      "id": "nav_font_scale",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Navigation Font Size Scale",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation Links"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Homepage Button Label",
      "default": "HOME"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Homepage Button URL"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Waitlist Button Label",
      "default": "WAITLIST ✦"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Waitlist Button URL"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Hero Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Hero Text & Icon Color",
      "default": "#161517"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Hero Title Color",
      "default": "#161517"
    },
    {
      "type": "color",
      "id": "docked_text_color",
      "label": "Docked Navbar Text & Icon Color",
      "default": "#161517"
    },
    {
      "type": "color",
      "id": "docked_bg_color",
      "label": "Docked Navbar Background Color",
      "default": "#f8f8f6"
    }
  ],
  "presets": [
    {
      "name": "Luxury Morphing Header"
    }
  ]
}
{% endschema %}
