<script>
  (function() {
    var p = (window.location.pathname || '').toLowerCase();
    var h = (window.location.href || '').toLowerCase();
    if (p.indexOf('waitlist') !== -1 || h.indexOf('waitlist') !== -1) {
      document.title = "Waitlist \u2014 Teekhi Bella";
      document.documentElement.classList.add('is-waitlist-mode');
    } else if (p.indexOf('product-inspect') !== -1 || p.indexOf('inspect') !== -1 || p.indexOf('products/skirt') !== -1 || p.indexOf('product/skirt') !== -1) {
      document.title = "cvnt's genda phool skirt \u2014 Teekhi Bella";
      document.documentElement.classList.add('is-inspect-mode');
    }
  })();
</script>

<style type="text/css">
  #waitlistAutoFallback,
  #inspectAutoFallback {
    display: none;
  }
  html.is-waitlist-mode #waitlistAutoFallback {
    display: block !important;
  }
  html.is-inspect-mode #inspectAutoFallback {
    display: block !important;
  }
  html.is-waitlist-mode #standard404Markup,
  html.is-waitlist-mode #inspectAutoFallback,
  html.is-waitlist-mode .header-group,
  html.is-waitlist-mode .footer-group,
  html.is-inspect-mode #standard404Markup,
  html.is-inspect-mode #waitlistAutoFallback,
  html.is-inspect-mode .header-group,
  html.is-inspect-mode .footer-group {
    display: none !important;
  }
  .template-404 .title + * {
    margin-top: 1rem;
  }
  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }
</style>

<div id="waitlistAutoFallback">
  {%- render 'atelier-waitlist-content' -%}
</div>

<div id="inspectAutoFallback">
  {%- render 'product-inspect-content' -%}
</div>

<div id="standard404Markup">
  <div class="template-404 page-width page-margin center">
    <p>
      {{ 'templates.404.subtext' | t }}
    </p>
    <h1 class="title">
      {{ 'templates.404.title' | t }}
    </h1>
    <a href="{{ routes.all_products_collection_url }}" class="button">
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>
</div>

<script>
  (function() {
    var p = (window.location.pathname || '').toLowerCase();
    var h = (window.location.href || '').toLowerCase();
    if (p.indexOf('waitlist') !== -1 || h.indexOf('waitlist') !== -1) {
      document.title = "Waitlist \u2014 Teekhi Bella";
      document.documentElement.classList.add('is-waitlist-mode');
      var wl = document.getElementById('waitlistAutoFallback');
      var std = document.getElementById('standard404Markup');
      if (wl) wl.style.display = 'block';
      if (std) std.style.display = 'none';
      var headers = document.querySelectorAll('.header-wrapper, #shopify-section-announcement-bar, .announcement-bar-section, .header-group, .footer-group');
      headers.forEach(function(el) {
        el.style.display = 'none';
      });
    }
  })();
</script>
