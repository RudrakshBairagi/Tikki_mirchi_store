{{ 'hanger-rack.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hanger-rack.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  @font-face {
    font-family: 'Ahsing';
    src: url('{{ "Ahsing.woff" | asset_url }}') format('woff'),
         url('{{ "Ahsing.otf" | asset_url }}') format('opentype'),
         url('{{ "typogama-ahsing.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  {%- if section.settings.heading_font_source == 'shopify' and section.settings.heading_font != blank -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'shopify' and section.settings.body_font != blank -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.tag_font_source == 'shopify' and section.settings.tag_font != blank -%}
    {{ section.settings.tag_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.btn_font_source == 'shopify' and section.settings.btn_font != blank -%}
    {{ section.settings.btn_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.separate_bottom_btn_styles and section.settings.bottom_btn_font_source == 'shopify' and section.settings.bottom_btn_font != blank -%}
    {{ section.settings.bottom_btn_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #HangerRack-{{ section.id }} {
    --rack-bg: {{ section.settings.bg_color | default: '#f8f8f6' }};
    --rack-rail-color: {{ section.settings.rail_color | default: '#7a818b' }};
    --rack-hanger-color: {{ section.settings.hanger_color | default: '#686f78' }};
    --rack-text-color: {{ section.settings.text_color | default: '#1a1819' }};
    --rack-accent-color: {{ section.settings.accent_color | default: '#b38728' }};
    --rack-sway-factor: {{ section.settings.sway_intensity | default: 4 }};
    --rack-item-width: {{ section.settings.item_width | default: 130 }}px;
    --rack-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --rack-padding-bottom: {{ section.settings.padding_bottom | default: 95 }}px;
    --rack-card-bg: {{ section.settings.floating_card_bg | default: '#1a1819' }};
    --rack-card-text: {{ section.settings.floating_card_text | default: '#ffffff' }};
    --rack-card-accent: {{ section.settings.floating_card_accent | default: '#d4af37' }};
    --rack-card-border: {{ section.settings.floating_card_border | default: 'rgba(255, 255, 255, 0.15)' }};
    --rack-rail-thickness: {{ section.settings.rail_thickness | default: 6 }}px;

    {%- if section.settings.heading_font_source == 'shopify' and section.settings.heading_font != blank -%}
      --rack-title-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --rack-title-weight: {{ section.settings.heading_font.weight }};
      --rack-title-style: {{ section.settings.heading_font.style }};
    {%- elsif section.settings.heading_font_source == 'ahsing' -%}
      --rack-title-font: 'Ahsing', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'ragara' or section.settings.heading_font_source == 'brand' -%}
      --rack-title-font: 'Ragara', 'Italiana', Georgia, 'Times New Roman', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'syne' -%}
      --rack-title-font: 'Syne', sans-serif;
      --rack-title-weight: 700;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'bodoni' -%}
      --rack-title-font: 'Bodoni Moda', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'playfair' -%}
      --rack-title-font: 'Playfair Display', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'italiana' -%}
      --rack-title-font: 'Italiana', Georgia, serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'cinzel' -%}
      --rack-title-font: 'Cinzel', serif;
      --rack-title-weight: 600;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'cormorant' -%}
      --rack-title-font: 'Cormorant Garamond', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'outfit' -%}
      --rack-title-font: 'Outfit', sans-serif;
      --rack-title-weight: 500;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'custom' and section.settings.custom_heading_font != blank -%}
      --rack-title-font: '{{ section.settings.custom_heading_font }}', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- else -%}
      --rack-title-font: 'Ragara', 'Italiana', Georgia, 'Times New Roman', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- endif -%}

    {%- if section.settings.body_font_source == 'shopify' and section.settings.body_font != blank -%}
      --rack-eyebrow-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --rack-subheading-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    {%- elsif section.settings.body_font_source == 'ahsing' -%}
      --rack-eyebrow-font: 'Ahsing', serif;
      --rack-subheading-font: 'Ahsing', serif;
    {%- elsif section.settings.body_font_source == 'custom' and section.settings.custom_body_font != blank -%}
      --rack-eyebrow-font: '{{ section.settings.custom_body_font }}', sans-serif;
      --rack-subheading-font: '{{ section.settings.custom_body_font }}', sans-serif;
    {%- else -%}
      --rack-eyebrow-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --rack-subheading-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    {%- endif -%}

    {%- if section.settings.tag_font_source == 'shopify' and section.settings.tag_font != blank -%}
      --rack-tag-font: {{ section.settings.tag_font.family }}, {{ section.settings.tag_font.fallback_families }};
    {%- elsif section.settings.tag_font_source == 'ahsing' -%}
      --rack-tag-font: 'Ahsing', serif;
    {%- elsif section.settings.tag_font_source == 'custom' and section.settings.custom_tag_font != blank -%}
      --rack-tag-font: '{{ section.settings.custom_tag_font }}', sans-serif;
    {%- else -%}
      --rack-tag-font: 'Plus Jakarta Sans', sans-serif;
    {%- endif -%}

    {%- if section.settings.btn_font_source == 'shopify' and section.settings.btn_font != blank -%}
      --rack-btn-font: {{ section.settings.btn_font.family }}, {{ section.settings.btn_font.fallback_families }};
    {%- elsif section.settings.btn_font_source == 'ahsing' -%}
      --rack-btn-font: 'Ahsing', serif;
    {%- elsif section.settings.btn_font_source == 'ragara' -%}
      --rack-btn-font: 'Ragara', 'Italiana', Georgia, serif;
    {%- elsif section.settings.btn_font_source == 'syne' -%}
      --rack-btn-font: 'Syne', sans-serif;
    {%- elsif section.settings.btn_font_source == 'bodoni' -%}
      --rack-btn-font: 'Bodoni Moda', serif;
    {%- elsif section.settings.btn_font_source == 'playfair' -%}
      --rack-btn-font: 'Playfair Display', serif;
    {%- elsif section.settings.btn_font_source == 'italiana' -%}
      --rack-btn-font: 'Italiana', Georgia, serif;
    {%- elsif section.settings.btn_font_source == 'cinzel' -%}
      --rack-btn-font: 'Cinzel', serif;
    {%- elsif section.settings.btn_font_source == 'cormorant' -%}
      --rack-btn-font: 'Cormorant Garamond', serif;
    {%- elsif section.settings.btn_font_source == 'outfit' -%}
      --rack-btn-font: 'Outfit', sans-serif;
    {%- elsif section.settings.btn_font_source == 'custom' and section.settings.custom_btn_font != blank -%}
      --rack-btn-font: '{{ section.settings.custom_btn_font }}', sans-serif;
    {%- else -%}
      --rack-btn-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    {%- endif -%}

    {%- if section.settings.separate_bottom_btn_styles -%}
      {%- if section.settings.bottom_btn_font_source == 'shopify' and section.settings.bottom_btn_font != blank -%}
        --rack-btn-bottom-font: {{ section.settings.bottom_btn_font.family }}, {{ section.settings.bottom_btn_font.fallback_families }};
      {%- elsif section.settings.bottom_btn_font_source == 'ahsing' -%}
        --rack-btn-bottom-font: 'Ahsing', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'ragara' -%}
        --rack-btn-bottom-font: 'Ragara', 'Italiana', Georgia, serif;
      {%- elsif section.settings.bottom_btn_font_source == 'syne' -%}
        --rack-btn-bottom-font: 'Syne', sans-serif;
      {%- elsif section.settings.bottom_btn_font_source == 'bodoni' -%}
        --rack-btn-bottom-font: 'Bodoni Moda', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'playfair' -%}
        --rack-btn-bottom-font: 'Playfair Display', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'italiana' -%}
        --rack-btn-bottom-font: 'Italiana', Georgia, serif;
      {%- elsif section.settings.bottom_btn_font_source == 'cinzel' -%}
        --rack-btn-bottom-font: 'Cinzel', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'cormorant' -%}
        --rack-btn-bottom-font: 'Cormorant Garamond', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'outfit' -%}
        --rack-btn-bottom-font: 'Outfit', sans-serif;
      {%- elsif section.settings.bottom_btn_font_source == 'custom' and section.settings.bottom_custom_btn_font != blank -%}
        --rack-btn-bottom-font: '{{ section.settings.bottom_custom_btn_font }}', sans-serif;
      {%- else -%}
        --rack-btn-bottom-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      {%- endif -%}
    {%- endif -%}

    --rack-heading-scale: {{ section.settings.heading_font_scale | default: 100 | divided_by: 100.0 }};
    --rack-subheading-scale: {{ section.settings.subheading_font_scale | default: 100 | divided_by: 100.0 }};
    --rack-title-spacing: {{ section.settings.heading_letter_spacing | default: 2 }}px;
  }

  #HangerRack-{{ section.id }} {
    position: relative;
    {%- if section.settings.bg_mode == 'gradient' and section.settings.bg_gradient != blank -%}
      background: {{ section.settings.bg_gradient }} !important;
    {%- elsif section.settings.bg_mode == 'image' and section.settings.bg_image != blank -%}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2600 }}') !important;
      background-size: cover !important;
      background-position: center !important;
    {%- else -%}
      background-color: var(--rack-bg) !important;
    {%- endif -%}
  }

  #HangerRack-{{ section.id }} .hanger-rack-bg-overlay {
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: {{ section.settings.bg_overlay_opacity | default: 0 | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  #HangerRack-{{ section.id }} .hanger-rack-container {
    position: relative;
    z-index: 2;
  }

  #HangerRack-{{ section.id }} .hanger-rack-title {
    font-family: var(--rack-title-font) !important;
    font-weight: var(--rack-title-weight, 400) !important;
    font-style: var(--rack-title-style, normal) !important;
    font-size: calc(clamp(34px, 4.5vw, 54px) * var(--rack-heading-scale, 1)) !important;
    letter-spacing: var(--rack-title-spacing, 0.04em) !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-eyebrow {
    font-family: var(--rack-eyebrow-font) !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-subheading {
    font-family: var(--rack-subheading-font) !important;
    font-size: calc(14px * var(--rack-subheading-scale, 1)) !important;
  }

  #HangerRack-{{ section.id }} .tag-code,
  #HangerRack-{{ section.id }} .tag-name,
  #HangerRack-{{ section.id }} .tag-price {
    font-family: var(--rack-tag-font) !important;
  }

  /* Critical display overrides ensuring Shopify base.css (div:empty { display:none }) never hides rail rod elements */
  #HangerRack-{{ section.id }} .hanger-rail-bar,
  #HangerRack-{{ section.id }} .hanger-rail-bar:empty,
  #HangerRack-{{ section.id }} .rail-rod,
  #HangerRack-{{ section.id }} .rail-rod:empty,
  #HangerRack-{{ section.id }} .rail-highlight,
  #HangerRack-{{ section.id }} .rail-highlight:empty,
  #HangerRack-{{ section.id }} .rail-bracket,
  #HangerRack-{{ section.id }} .rail-bracket:empty,
  #HangerRack-{{ section.id }} .hanger-garment-shadow,
  #HangerRack-{{ section.id }} .hanger-garment-shadow:empty,
  #HangerRack-{{ section.id }} .tag-thread,
  #HangerRack-{{ section.id }} .tag-thread:empty {
    display: block !important;
  }
  #HangerRack-{{ section.id }} .hanger-floating-card {
    background: var(--rack-card-bg) !important;
    border-color: var(--rack-card-border) !important;
    color: var(--rack-card-text) !important;
  }
  #HangerRack-{{ section.id }} .hanger-floating-card .floating-card-title {
    color: var(--rack-card-text) !important;
  }
  #HangerRack-{{ section.id }} .hanger-floating-card .floating-card-link {
    color: var(--rack-card-accent) !important;
  }
  #HangerRack-{{ section.id }} .hanger-rail-bar .rail-rod {
    height: var(--rack-rail-thickness) !important;
  }

  /* Dynamic customizable Waitlist Buttons */
  #HangerRack-{{ section.id }} .rack-waitlist-btn {
    font-family: var(--rack-btn-font, 'Plus Jakarta Sans', sans-serif) !important;
    font-size: {{ section.settings.btn_font_size | default: 12 }}px !important;
    font-weight: {{ section.settings.btn_font_weight | default: 600 }} !important;
    font-style: {{ section.settings.btn_font_style | default: 'normal' }} !important;
    letter-spacing: {{ section.settings.btn_letter_spacing | default: 2 }}px !important;
    text-transform: {{ section.settings.btn_text_transform | default: 'uppercase' }} !important;
    background: {{ section.settings.btn_bg_color | default: '#1a1819' }} !important;
    color: {{ section.settings.btn_text_color | default: '#ffffff' }} !important;
    border: {{ section.settings.btn_border_width | default: 1 }}px solid {{ section.settings.btn_border_color | default: 'rgba(255, 255, 255, 0.18)' }} !important;
    border-radius: {{ section.settings.btn_border_radius | default: 40 }}px !important;
    padding: {{ section.settings.btn_padding_y | default: 13 }}px {{ section.settings.btn_padding_x | default: 34 }}px !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 12px !important;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1) !important;
    cursor: pointer !important;
  }
  #HangerRack-{{ section.id }} .rack-waitlist-btn:hover {
    background: {{ section.settings.btn_hover_bg_color | default: '#000000' }} !important;
    color: {{ section.settings.btn_hover_text_color | default: '#ffffff' }} !important;
    border-color: {{ section.settings.btn_hover_border_color | default: '#d4af37' }} !important;
    transform: translateY(-2px) !important;
  }
  #HangerRack-{{ section.id }} .rack-waitlist-btn .btn-sparkle {
    color: {{ section.settings.btn_sparkle_color | default: '#d4af37' }} !important;
  }

  {%- if section.settings.separate_bottom_btn_styles -%}
    #HangerRack-{{ section.id }} .rack-waitlist-btn-wrap-bottom .rack-waitlist-btn {
      font-family: var(--rack-btn-bottom-font, var(--rack-btn-font, 'Plus Jakarta Sans', sans-serif)) !important;
      font-size: {{ section.settings.bottom_btn_font_size | default: 12 }}px !important;
      font-weight: {{ section.settings.bottom_btn_font_weight | default: 600 }} !important;
      font-style: {{ section.settings.bottom_btn_font_style | default: 'normal' }} !important;
      letter-spacing: {{ section.settings.bottom_btn_letter_spacing | default: 2 }}px !important;
      text-transform: {{ section.settings.bottom_btn_text_transform | default: 'uppercase' }} !important;
      background: {{ section.settings.bottom_btn_bg_color | default: '#1a1819' }} !important;
      color: {{ section.settings.bottom_btn_text_color | default: '#ffffff' }} !important;
      border: {{ section.settings.bottom_btn_border_width | default: 1 }}px solid {{ section.settings.bottom_btn_border_color | default: 'rgba(255, 255, 255, 0.18)' }} !important;
      border-radius: {{ section.settings.bottom_btn_border_radius | default: 40 }}px !important;
      padding: {{ section.settings.bottom_btn_padding_y | default: 13 }}px {{ section.settings.bottom_btn_padding_x | default: 34 }}px !important;
    }
    #HangerRack-{{ section.id }} .rack-waitlist-btn-wrap-bottom .rack-waitlist-btn:hover {
      background: {{ section.settings.bottom_btn_hover_bg_color | default: '#000000' }} !important;
      color: {{ section.settings.bottom_btn_hover_text_color | default: '#ffffff' }} !important;
      border-color: {{ section.settings.bottom_btn_hover_border_color | default: '#d4af37' }} !important;
    }
    #HangerRack-{{ section.id }} .rack-waitlist-btn-wrap-bottom .rack-waitlist-btn .btn-sparkle {
      color: {{ section.settings.bottom_btn_sparkle_color | default: '#d4af37' }} !important;
    }
  {%- endif -%}
{%- endstyle -%}

<section
  id="HangerRack-{{ section.id }}"
  class="hanger-rack-section"
  data-sway-intensity="{{ section.settings.sway_intensity | default: 4 }}"
  data-spring-speed="{{ section.settings.spring_speed | default: 5 }}"
  data-damping-rate="{{ section.settings.damping_rate | default: 5 }}"
  data-hit-force="{{ section.settings.hit_force | default: 5 }}"
  data-part-spread="{{ section.settings.part_spread | default: 50 }}"
  data-show-tuning="{% if section.settings.show_tuning_panel == true %}true{% else %}false{% endif %}"
  data-nudge="{% if section.settings.enable_nudge %}true{% else %}false{% endif %}"
  data-drag="{% if section.settings.enable_drag %}true{% else %}false{% endif %}"
  data-sound-1="{{ 'sound_1.mp3' | asset_url }}"
  data-sound-2="{{ 'sound_2.mp3' | asset_url }}"
  data-sound-3="{{ 'sound_3.mp3' | asset_url }}"
  data-sound1="{{ 'sound_1.mp3' | asset_url }}"
  data-sound2="{{ 'sound_2.mp3' | asset_url }}"
  data-sound3="{{ 'sound_3.mp3' | asset_url }}"
  data-card-title="{{ section.settings.floating_card_title | default: 'Couture Piece' | escape }}"
  data-card-btn-text="{{ section.settings.floating_card_btn_text | default: 'Inspect Piece' | escape }}"
  aria-label="{{ section.settings.heading | default: 'House of Royals Runway Rack' }}"
>
  <div class="hanger-rack-bg-overlay" aria-hidden="true"></div>
  <div class="hanger-rack-container">
    {%- assign show_top = false -%}
    {%- if section.settings.show_top_waitlist_btn != false and section.settings.show_waitlist_buttons != false -%}
      {%- assign show_top = true -%}
    {%- endif -%}
    {%- if show_top -%}
      {%- assign default_wl_link = routes.root_url | append: 'pages/waitlist' | replace: '//', '/' -%}
      {%- if section.settings.waitlist_url != blank -%}
        {%- assign default_wl_link = section.settings.waitlist_url -%}
      {%- endif -%}
      <div class="rack-waitlist-btn-wrap-top">
        <a href="{{ default_wl_link }}" class="rack-waitlist-btn" title="Join the exclusive atelier waitlist">
          {%- if section.settings.show_btn_sparkle != false -%}
            <span class="btn-sparkle" aria-hidden="true">{{ section.settings.btn_sparkle_icon | default: '✦' }}</span>
          {%- endif -%}
          <span>{{ section.settings.top_waitlist_btn_text | default: section.settings.waitlist_btn_text | default: 'Join the waitlist' }}</span>
          {%- if section.settings.show_btn_arrow != false -%}
            <span class="btn-arrow" aria-hidden="true">{{ section.settings.btn_arrow_icon | default: '⟶' }}</span>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.show_header -%}
      <!-- Header: Editorial & Minimalist -->
      <div class="hanger-rack-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="hanger-rack-eyebrow">
            <span class="rack-eyebrow-sparkle">✦</span>
            <span>{{ section.settings.eyebrow }}</span>
            <span class="rack-eyebrow-sparkle">✦</span>
          </div>
        {%- endif -%}

        <h2 class="hanger-rack-title">{{ section.settings.heading | default: 'House of Royals' }}</h2>

        {%- if section.settings.subheading != blank -%}
          <p class="hanger-rack-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- The Boutique Rail & Clothes Rack Stage -->
    <div class="hanger-rack-stage" tabIndex="0" role="region" aria-label="Interactive Clothes Rack">
      <!-- Scrollable / Draggable Track of Hanging Garments -->
      <div class="hanger-rack-track-wrap">
        <div class="hanger-rack-track" id="HangerTrack-{{ section.id }}">
          <!-- Physical Overhead Rail Bar travelling with the rack -->
          <div class="hanger-rail-bar" aria-hidden="true">
            <div class="rail-rod"><span class="rail-rod-core"></span></div>
            <div class="rail-bracket bracket-left"><span class="bracket-cap"></span></div>
            <div class="rail-bracket bracket-right"><span class="bracket-cap"></span></div>
            <div class="rail-highlight"><span class="highlight-line"></span></div>
          </div>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- assign look_num = forloop.index -%}
              {%- assign fallback_idx = forloop.index0 | modulo: 6 | plus: 1 -%}
              {%- assign default_front_file = 'hanger-look-' | append: fallback_idx | append: '.png' -%}
              {%- assign default_side_file = 'hanger-look-' | append: fallback_idx | append: '-side.png' -%}

              {%- assign dress_front_src = default_front_file | asset_url -%}
              {%- if block.settings.custom_image != blank -%}
                {%- assign dress_front_src = block.settings.custom_image | image_url: width: 800 -%}
              {%- elsif block.settings.product != blank and block.settings.product.featured_image != blank -%}
                {%- assign dress_front_src = block.settings.product.featured_image | image_url: width: 800 -%}
              {%- endif -%}

              {%- assign dress_side_src = default_side_file | asset_url -%}
              {%- if block.settings.custom_side_image != blank -%}
                {%- assign dress_side_src = block.settings.custom_side_image | image_url: width: 800 -%}
              {%- endif -%}

              {%- assign dress_title = block.settings.title -%}
              {%- if dress_title == blank and block.settings.product != blank -%}
                {%- assign dress_title = block.settings.product.title -%}
              {%- endif -%}
              {%- if dress_title == blank -%}
                {%- assign dress_title = 'Atelier Look ' | append: look_num -%}
              {%- endif -%}

              {%- assign dress_price = block.settings.price -%}
              {%- if dress_price == blank and block.settings.product != blank -%}
                {%- assign dress_price = block.settings.product.price | money -%}
              {%- endif -%}

              {%- assign default_inspect_link = routes.root_url | append: 'pages/product-inspect' | replace: '//', '/' -%}
              {%- if section.settings.inspect_url != blank -%}
                {%- assign default_inspect_link = section.settings.inspect_url -%}
              {%- endif -%}
              {%- assign dress_link = default_inspect_link -%}
              {%- if block.settings.link != blank -%}
                {%- assign dress_link = block.settings.link -%}
              {%- elsif block.settings.product != blank and block.settings.product.url != blank -%}
                {%- assign dress_link = block.settings.product.url -%}
              {%- endif -%}

              <!-- Individual Hanging Garment Unit -->
              <div
                class="hanger-item"
                data-index="{{ forloop.index0 }}"
                data-title="{{ dress_title | escape }}"
                data-price="{{ dress_price | escape }}"
                data-tag="{{ block.settings.tag | default: 'LOOK ' | append: look_num }}"
                data-link="{{ dress_link }}"
                {{ block.shopify_attributes }}
              >
                <!-- Whole Assembly that Pivots around top hook contact point -->
                <div class="hanger-assembly">
                  <!-- Distinct Side & Front Wire Hangers -->
                  <div class="hanger-wire-wrapper" aria-hidden="true">
                    <!-- Slender Side View Hanger (Visible at rest on rail) -->
                    <svg
                      class="hanger-wire-svg hanger-wire-side"
                      viewBox="0 0 64 84"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M 32 4 C 22 4, 15 11, 15 20 C 15 29, 26 34, 32 39 L 32 47"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        class="hook-curve"
                      />
                      <path
                        d="M 32 4 C 36 4, 38 6, 38 8"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                      />
                      <path
                        d="M 23 76 C 27 62, 29 53, 32 47 C 35 53, 37 62, 41 76"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M 24 76 L 40 76"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>

                    <!-- Wide Front View Hanger (Revealed on hover) -->
                    <svg
                      class="hanger-wire-svg hanger-wire-front"
                      viewBox="0 0 160 84"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M 80 4 C 70 4, 63 11, 63 20 C 63 29, 74 34, 80 39 L 80 47"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        class="hook-curve"
                      />
                      <path
                        d="M 80 4 C 84 4, 86 6, 86 8"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                      />
                      <path
                        d="M 12 76 L 80 47 L 148 76"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M 15 76 L 145 76"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>
                  </div>

                  <!-- Hanging Garment Silhouette (Dual Side-to-Front 3D Pivot Engine) -->
                  <div class="hanger-garment-wrap">
                    <div class="hanger-garment-inner">
                      <!-- Side Profile (Default resting view on boutique rail) -->
                      <img
                        src="{{ dress_side_src }}"
                        alt="{{ dress_title | escape }} — Side View"
                        class="hanger-garment-img garment-side-img"
                        loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                        width="360"
                        height="700"
                      >
                      <!-- Front Profile (Revealed on hover / tap) -->
                      <img
                        src="{{ dress_front_src }}"
                        alt="{{ dress_title | escape }} — Front View"
                        class="hanger-garment-img garment-front-img"
                        loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                        width="360"
                        height="700"
                      >
                      <!-- Soft Dynamic Drop Shadow on the Atelier Wall -->
                      <div class="hanger-garment-shadow" aria-hidden="true"><span></span></div>
                    </div>
                  </div>

                  <!-- Delicate Swing Price Tag dangling from the hanger -->
                  <div class="hanger-swing-tag" aria-hidden="true">
                    <div class="tag-thread"><span></span></div>
                    <div class="tag-body">
                      <span class="tag-code">{{ block.settings.tag | default: 'LOOK ' | append: look_num }}</span>
                      <span class="tag-name">{{ dress_title }}</span>
                      {%- if dress_price != blank -%}
                        <span class="tag-price">{{ dress_price }}</span>
                      {%- endif -%}
                    </div>
                  </div>

                  <!-- Interactive Action Overlay Button / Link -->
                  <a href="{{ dress_link }}" class="hanger-action-hitbox" aria-label="View {{ dress_title | escape }}">
                    <span class="sr-only">View {{ dress_title }}</span>
                  </a>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- Optional subtle ambient bottom hint -->
      <div class="hanger-rack-hint" aria-hidden="true">
        <span class="hint-icon">{{ section.settings.hint_icon_left | default: '⟵' }}</span>
        <span class="hint-text">{{ section.settings.hint_text | default: 'Hover to sway • Drag along the rack' }}</span>
        <span class="hint-icon">{{ section.settings.hint_icon_right | default: '⟶' }}</span>
      </div>

      {%- assign show_bottom = false -%}
      {%- if section.settings.show_bottom_waitlist_btn != false and section.settings.show_waitlist_buttons != false -%}
        {%- assign show_bottom = true -%}
      {%- endif -%}
      {%- if show_bottom -%}
        {%- assign default_wl_link = routes.root_url | append: 'pages/waitlist' | replace: '//', '/' -%}
        {%- if section.settings.waitlist_url != blank -%}
          {%- assign default_wl_link = section.settings.waitlist_url -%}
        {%- endif -%}
        <div class="rack-waitlist-btn-wrap-bottom">
          <a href="{{ default_wl_link }}" class="rack-waitlist-btn" title="Join the exclusive atelier waitlist">
            {%- if section.settings.show_btn_sparkle != false -%}
              <span class="btn-sparkle" aria-hidden="true">{{ section.settings.btn_sparkle_icon | default: '✦' }}</span>
            {%- endif -%}
            <span>{{ section.settings.bottom_waitlist_btn_text | default: section.settings.waitlist_btn_text | default: 'Join the waitlist' }}</span>
            {%- if section.settings.show_btn_arrow != false -%}
              <span class="btn-arrow" aria-hidden="true">{{ section.settings.btn_arrow_icon | default: '⟶' }}</span>
            {%- endif -%}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

