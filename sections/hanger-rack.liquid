{{ 'hanger-rack.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hanger-rack.js' | asset_url }}" defer="defer"></script>

{% render 'font-faces' %}

{%- style -%}
  /* Font faces loaded via snippets/font-faces.liquid */

  {%- if section.settings.heading_font_source == 'shopify' and section.settings.heading_font != blank -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.body_font_source == 'shopify' and section.settings.body_font != blank -%}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.tag_font_source == 'shopify' and section.settings.tag_font != blank -%}
    {{ section.settings.tag_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.btn_font_source == 'shopify' and section.settings.btn_font != blank -%}
    {{ section.settings.btn_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.separate_bottom_btn_styles and section.settings.bottom_btn_font_source == 'shopify' and section.settings.bottom_btn_font != blank -%}
    {{ section.settings.bottom_btn_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #HangerRack-{{ section.id }} {
    --rack-bg: {{ section.settings.bg_color | default: '#f8f8f6' }};
    --rack-rail-color: {{ section.settings.rail_color | default: '#7a818b' }};
    --rack-hanger-color: {{ section.settings.hanger_color | default: '#686f78' }};
    --rack-text-color: {{ section.settings.text_color | default: '#1a1819' }};
    --rack-accent-color: {{ section.settings.accent_color | default: '#b38728' }};
    --rack-sway-factor: {{ section.settings.sway_intensity | default: 4 }};
    --rack-item-width: {{ section.settings.item_width | default: 130 }}px;
    --rack-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --rack-padding-bottom: {{ section.settings.padding_bottom | default: 95 }}px;
    --rack-card-bg: {{ section.settings.floating_card_bg | default: '#1a1819' }};
    --rack-card-text: {{ section.settings.floating_card_text | default: '#ffffff' }};
    --rack-card-accent: {{ section.settings.floating_card_accent | default: '#d4af37' }};
    --rack-card-border: {{ section.settings.floating_card_border | default: 'rgba(255, 255, 255, 0.15)' }};
    --rack-rail-thickness: {{ section.settings.rail_thickness | default: 6 }}px;

    {%- if section.settings.heading_font_source == 'shopify' and section.settings.heading_font != blank -%}
      --rack-title-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --rack-title-weight: {{ section.settings.heading_font.weight }};
      --rack-title-style: {{ section.settings.heading_font.style }};
    {%- elsif section.settings.heading_font_source == 'ahsing' -%}
      --rack-title-font: 'Ahsing', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'ragara' or section.settings.heading_font_source == 'brand' -%}
      --rack-title-font: 'Ragara', 'Italiana', Georgia, 'Times New Roman', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'syne' -%}
      --rack-title-font: 'Syne', sans-serif;
      --rack-title-weight: 700;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'bodoni' -%}
      --rack-title-font: 'Bodoni Moda', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'playfair' -%}
      --rack-title-font: 'Playfair Display', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'italiana' -%}
      --rack-title-font: 'Italiana', Georgia, serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'cinzel' -%}
      --rack-title-font: 'Cinzel', serif;
      --rack-title-weight: 600;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'cormorant' -%}
      --rack-title-font: 'Cormorant Garamond', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'outfit' -%}
      --rack-title-font: 'Outfit', sans-serif;
      --rack-title-weight: 500;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'sixcaps' -%}
      --rack-title-font: 'Six Caps', sans-serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- elsif section.settings.heading_font_source == 'custom' and section.settings.custom_heading_font != blank -%}
      --rack-title-font: '{{ section.settings.custom_heading_font }}', serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- else -%}
      --rack-title-font: 'Six Caps', sans-serif;
      --rack-title-weight: 400;
      --rack-title-style: normal;
    {%- endif -%}

    {%- if section.settings.body_font_source == 'shopify' and section.settings.body_font != blank -%}
      --rack-eyebrow-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
      --rack-subheading-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    {%- elsif section.settings.body_font_source == 'sixcaps' -%}
      --rack-eyebrow-font: 'Six Caps', sans-serif;
      --rack-subheading-font: 'Six Caps', sans-serif;
    {%- elsif section.settings.body_font_source == 'ahsing' -%}
      --rack-eyebrow-font: 'Ahsing', serif;
      --rack-subheading-font: 'Ahsing', serif;
    {%- elsif section.settings.body_font_source == 'custom' and section.settings.custom_body_font != blank -%}
      --rack-eyebrow-font: '{{ section.settings.custom_body_font }}', sans-serif;
      --rack-subheading-font: '{{ section.settings.custom_body_font }}', sans-serif;
    {%- else -%}
      --rack-eyebrow-font: 'Six Caps', sans-serif;
      --rack-subheading-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    {%- endif -%}

    {%- if section.settings.tag_font_source == 'shopify' and section.settings.tag_font != blank -%}
      --rack-tag-font: {{ section.settings.tag_font.family }}, {{ section.settings.tag_font.fallback_families }};
    {%- elsif section.settings.tag_font_source == 'ahsing' -%}
      --rack-tag-font: 'Ahsing', serif;
    {%- elsif section.settings.tag_font_source == 'custom' and section.settings.custom_tag_font != blank -%}
      --rack-tag-font: '{{ section.settings.custom_tag_font }}', sans-serif;
    {%- else -%}
      --rack-tag-font: 'Plus Jakarta Sans', sans-serif;
    {%- endif -%}

    {%- if section.settings.btn_font_source == 'shopify' and section.settings.btn_font != blank -%}
      --rack-btn-font: {{ section.settings.btn_font.family }}, {{ section.settings.btn_font.fallback_families }};
    {%- elsif section.settings.btn_font_source == 'sixcaps' -%}
      --rack-btn-font: 'Six Caps', sans-serif;
    {%- elsif section.settings.btn_font_source == 'ahsing' -%}
      --rack-btn-font: 'Ahsing', serif;
    {%- elsif section.settings.btn_font_source == 'ragara' -%}
      --rack-btn-font: 'Ragara', 'Italiana', Georgia, serif;
    {%- elsif section.settings.btn_font_source == 'syne' -%}
      --rack-btn-font: 'Syne', sans-serif;
    {%- elsif section.settings.btn_font_source == 'bodoni' -%}
      --rack-btn-font: 'Bodoni Moda', serif;
    {%- elsif section.settings.btn_font_source == 'playfair' -%}
      --rack-btn-font: 'Playfair Display', serif;
    {%- elsif section.settings.btn_font_source == 'italiana' -%}
      --rack-btn-font: 'Italiana', Georgia, serif;
    {%- elsif section.settings.btn_font_source == 'cinzel' -%}
      --rack-btn-font: 'Cinzel', serif;
    {%- elsif section.settings.btn_font_source == 'cormorant' -%}
      --rack-btn-font: 'Cormorant Garamond', serif;
    {%- elsif section.settings.btn_font_source == 'outfit' -%}
      --rack-btn-font: 'Outfit', sans-serif;
    {%- elsif section.settings.btn_font_source == 'custom' and section.settings.custom_btn_font != blank -%}
      --rack-btn-font: '{{ section.settings.custom_btn_font }}', sans-serif;
    {%- else -%}
      --rack-btn-font: 'Six Caps', sans-serif;
    {%- endif -%}

    {%- if section.settings.separate_bottom_btn_styles -%}
      {%- if section.settings.bottom_btn_font_source == 'shopify' and section.settings.bottom_btn_font != blank -%}
        --rack-btn-bottom-font: {{ section.settings.bottom_btn_font.family }}, {{ section.settings.bottom_btn_font.fallback_families }};
      {%- elsif section.settings.bottom_btn_font_source == 'sixcaps' -%}
        --rack-btn-bottom-font: 'Six Caps', sans-serif;
      {%- elsif section.settings.bottom_btn_font_source == 'ahsing' -%}
        --rack-btn-bottom-font: 'Ahsing', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'ragara' -%}
        --rack-btn-bottom-font: 'Ragara', 'Italiana', Georgia, serif;
      {%- elsif section.settings.bottom_btn_font_source == 'syne' -%}
        --rack-btn-bottom-font: 'Syne', sans-serif;
      {%- elsif section.settings.bottom_btn_font_source == 'bodoni' -%}
        --rack-btn-bottom-font: 'Bodoni Moda', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'playfair' -%}
        --rack-btn-bottom-font: 'Playfair Display', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'italiana' -%}
        --rack-btn-bottom-font: 'Italiana', Georgia, serif;
      {%- elsif section.settings.bottom_btn_font_source == 'cinzel' -%}
        --rack-btn-bottom-font: 'Cinzel', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'cormorant' -%}
        --rack-btn-bottom-font: 'Cormorant Garamond', serif;
      {%- elsif section.settings.bottom_btn_font_source == 'outfit' -%}
        --rack-btn-bottom-font: 'Outfit', sans-serif;
      {%- elsif section.settings.bottom_btn_font_source == 'custom' and section.settings.bottom_custom_btn_font != blank -%}
        --rack-btn-bottom-font: '{{ section.settings.bottom_custom_btn_font }}', sans-serif;
      {%- else -%}
        --rack-btn-bottom-font: 'Six Caps', sans-serif;
      {%- endif -%}
    {%- endif -%}

    --rack-heading-scale: {{ section.settings.heading_font_scale | default: 100 | divided_by: 100.0 }};
    --rack-eyebrow-scale: {{ section.settings.eyebrow_font_scale | default: 100 | divided_by: 100.0 }};
    --rack-subheading-scale: {{ section.settings.subheading_font_scale | default: 100 | divided_by: 100.0 }};
    --rack-title-spacing: {{ section.settings.heading_letter_spacing | default: 2 }}px;
  }

  #HangerRack-{{ section.id }} {
    position: relative !important;
    background-color: #1a221d !important;
    background-image: url('{{ "background_final.png" | asset_url }}') !important;
    background-size: cover !important;
    background-position: center top !important;
    background-repeat: no-repeat !important;
    min-height: calc(100dvh - 80px) !important;
    padding-top: clamp(20px, 4vh, 40px) !important;
    padding-bottom: clamp(24px, 4.5vh, 44px) !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-sizing: border-box !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-bg-overlay {
    display: none !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-container {
    position: relative !important;
    z-index: 2 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    height: 100% !important;
    min-height: calc(100dvh - 140px) !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    box-sizing: border-box !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-header {
    margin: 0 auto clamp(8px, 2vh, 18px) auto !important;
    padding: 0 16px !important;
    text-align: center !important;
    z-index: 5 !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-eyebrow,
  #HangerRack-{{ section.id }} .hanger-rack-subheading,
  #HangerRack-{{ section.id }} .rack-waitlist-btn-wrap-top,
  #HangerRack-{{ section.id }} .hanger-rail-bar,
  #HangerRack-{{ section.id }} .hanger-rail-bar:empty,
  #HangerRack-{{ section.id }} .hanger-rack-hint {
    display: none !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-title {
    font-family: 'Six Caps', sans-serif !important;
    font-size: clamp(54px, 14vw, 84px) !important;
    font-weight: 400 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    line-height: 0.9 !important;
    margin: 0 auto !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45) !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-stage {
    position: absolute !important;
    top: var(--rod-top, calc(22.4% - 10px)) !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    align-items: center !important;
    z-index: 4 !important;
    overflow: visible !important;
    touch-action: pan-x !important;
    overscroll-behavior: none !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-track-wrap {
    width: 100% !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    touch-action: pan-x !important;
    overscroll-behavior-y: none !important;
    overscroll-behavior-x: contain !important;
    padding-top: 10px !important;
    padding-bottom: 24px !important;
    clip-path: var(--alcove-clip, polygon(26.8% 0%, 73.4% 0%, 73.0% 100%, 27.8% 100%)) !important;
    -webkit-clip-path: var(--alcove-clip, polygon(26.8% 0%, 73.4% 0%, 73.0% 100%, 27.8% 100%)) !important;
    scrollbar-width: none !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-track-wrap::-webkit-scrollbar {
    display: none !important;
  }

  #HangerRack-{{ section.id }} .hanger-rack-track {
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start !important;
    gap: clamp(8px, 1.2vw, 16px) !important;
    padding: 0 40px !important;
    touch-action: pan-x !important;
    overflow-y: hidden !important;
  }

  #HangerRack-{{ section.id }} .hanger-item {
    width: clamp(96px, 8vw, 122px) !important;
    flex: 0 0 clamp(96px, 8vw, 122px) !important;
  }

  #HangerRack-{{ section.id }} .hanger-garment-img {
    max-height: clamp(260px, 36vh, 320px) !important;
    width: auto !important;
  }

  #HangerRack-{{ section.id }} .hanger-floating-card {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Bottom Waitlist CTA Pill Button */
  #HangerRack-{{ section.id }} .rack-waitlist-btn-wrap-bottom {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    bottom: clamp(14px, 2.8vh, 28px) !important;
    top: auto !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    z-index: 12 !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    pointer-events: auto !important;
  }

  #HangerRack-{{ section.id }} .rack-waitlist-btn {
    background: #000000 !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.22) !important;
    font-family: 'Six Caps', sans-serif !important;
    font-size: clamp(26px, 7vw, 34px) !important;
    font-weight: 400 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    padding: 10px 44px 8px 44px !important;
    border-radius: 9999px !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7) !important;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1 !important;
    cursor: pointer !important;
  }

  #HangerRack-{{ section.id }} .rack-waitlist-btn:hover {
    background: #151515 !important;
    border-color: rgba(255, 255, 255, 0.5) !important;
    transform: scale(1.03) !important;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.85) !important;
  }

  #HangerRack-{{ section.id }} .rack-waitlist-btn .btn-arrow,
  #HangerRack-{{ section.id }} .rack-waitlist-btn .btn-sparkle {
    display: none !important;
  }

  /* Yellow Bench Outfit Title Display (Six Caps Typography) */
  #HangerRack-{{ section.id }} .hanger-bench-outfit-title {
    position: absolute !important;
    left: 50% !important;
    transform: translateX(-50%) translateY(4px) !important;
    top: var(--bench-title-top, 72%) !important;
    z-index: 15 !important;
    text-decoration: none !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    width: max-content !important;
    max-width: 27% !important;
    margin: 0 !important;
    padding: 0 !important;
    pointer-events: none !important;
    cursor: pointer !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.3s ease !important;
  }

  #HangerRack-{{ section.id }} .hanger-bench-outfit-title.is-visible,
  #HangerRack-{{ section.id }} .hanger-rack-container:has(.hanger-item.is-hovered) .hanger-bench-outfit-title,
  #HangerRack-{{ section.id }} .hanger-rack-container:has(.hanger-item.is-popped-out) .hanger-bench-outfit-title {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateX(-50%) translateY(0) !important;
  }

  #HangerRack-{{ section.id }} .hanger-bench-outfit-title.is-visible:hover,
  #HangerRack-{{ section.id }} .hanger-bench-outfit-title:hover {
    transform: translateX(-50%) translateY(0) scale(1.03) !important;
  }

  #HangerRack-{{ section.id }} .bench-outfit-text {
    font-family: 'Six Caps', sans-serif !important;
    font-size: clamp(18px, 4.8vw, 25px) !important;
    font-weight: 400 !important;
    letter-spacing: 0.02em !important;
    line-height: 0.9 !important;
    color: #000000 !important;
    text-align: center !important;
    white-space: nowrap !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    transition: opacity 0.22s ease, transform 0.22s ease !important;
  }

  /* Mobile Layout Overrides */
  @media (max-width: 768px) {
    #HangerRack-{{ section.id }} {
      min-height: calc(100dvh - 60px) !important;
      height: calc(100dvh - 60px) !important;
      max-height: calc(100dvh - 60px) !important;
      padding: 0 !important;
    }

    #HangerRack-{{ section.id }} .hanger-rack-container {
      width: 100% !important;
      height: 100% !important;
      display: block !important;
    }

    #HangerRack-{{ section.id }} .hanger-rack-header {
      position: absolute !important;
      top: clamp(8px, 2vh, 18px) !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 10 !important;
    }

    #HangerRack-{{ section.id }} .hanger-rack-title {
      font-size: clamp(52px, 13.5vw, 70px) !important;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6) !important;
    }

    #HangerRack-{{ section.id }} .hanger-rack-stage {
      top: var(--rod-top, calc(22.94% - 10px)) !important;
      z-index: 5 !important;
    }

    #HangerRack-{{ section.id }} .hanger-rack-track-wrap {
      padding: 0 !important;
      margin: 0 !important;
      -webkit-overflow-scrolling: touch !important;
    }

    #HangerRack-{{ section.id }} .hanger-rack-track {
      justify-content: flex-start !important;
      gap: clamp(14px, 3.5vw, 22px) !important;
      padding: 0 calc(50vw - 65px) !important;
      width: max-content !important;
      min-width: 100% !important;
    }

    #HangerRack-{{ section.id }} .hanger-item {
      width: clamp(118px, 32vw, 138px) !important;
      flex: 0 0 clamp(118px, 32vw, 138px) !important;
      display: block !important;
    }

    #HangerRack-{{ section.id }} .hanger-item .hanger-wire-wrapper {
      width: 95px !important;
      height: 52px !important;
      margin: 0 auto -22px auto !important;
    }

    #HangerRack-{{ section.id }} .hanger-item .hanger-wire-svg {
      stroke: #d0c5b4 !important;
    }

    #HangerRack-{{ section.id }} .hanger-garment-img {
      height: clamp(280px, 38vh, 340px) !important;
      max-height: none !important;
      width: auto !important;
    }
  }
{%- endstyle -%}

<section
  id="HangerRack-{{ section.id }}"
  class="hanger-rack-section"
  data-sway-intensity="{{ section.settings.sway_intensity | default: 4 }}"
  data-spring-speed="{{ section.settings.spring_speed | default: 5 }}"
  data-damping-rate="{{ section.settings.damping_rate | default: 5 }}"
  data-hit-force="{{ section.settings.hit_force | default: 5 }}"
  data-part-spread="{{ section.settings.part_spread | default: 50 }}"
  data-show-tuning="{% if section.settings.show_tuning_panel == true %}true{% else %}false{% endif %}"
  data-nudge="{% if section.settings.enable_nudge %}true{% else %}false{% endif %}"
  data-drag="{% if section.settings.enable_drag %}true{% else %}false{% endif %}"
  data-sound-1="{{ 'sound_1.mp3' | asset_url }}"
  data-sound-2="{{ 'sound_2.mp3' | asset_url }}"
  data-sound-3="{{ 'sound_3.mp3' | asset_url }}"
  data-sound1="{{ 'sound_1.mp3' | asset_url }}"
  data-sound2="{{ 'sound_2.mp3' | asset_url }}"
  data-sound3="{{ 'sound_3.mp3' | asset_url }}"
  data-card-title="{{ section.settings.floating_card_title | default: 'Couture Piece' | escape }}"
  data-card-btn-text="{{ section.settings.floating_card_btn_text | default: 'Inspect Piece' | escape }}"
  aria-label="{{ section.settings.heading | default: 'House of Royals Runway Rack' }}"
>
  <div class="hanger-rack-bg-overlay" aria-hidden="true"></div>
  <div class="hanger-rack-container">
    {%- if section.settings.show_header -%}
      <!-- Header: Editorial & Minimalist -->
      <div class="hanger-rack-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="hanger-rack-eyebrow">
            <span class="rack-eyebrow-sparkle">✦</span>
            <span>{{ section.settings.eyebrow }}</span>
            <span class="rack-eyebrow-sparkle">✦</span>
          </div>
        {%- endif -%}

        <h2 class="hanger-rack-title">{{ section.settings.heading | default: 'House of Royals' }}</h2>

        {%- if section.settings.subheading != blank -%}
          <p class="hanger-rack-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign show_top = false -%}
    {%- if section.settings.show_top_waitlist_btn != false -%}
      {%- assign show_top = true -%}
    {%- elsif section.settings.show_waitlist_buttons != false -%}
      {%- assign show_top = true -%}
    {%- endif -%}
    {%- if show_top -%}
      {%- assign default_wl_link = routes.root_url | append: 'pages/waitlist' | replace: '//', '/' -%}
      {%- if section.settings.waitlist_url != blank -%}
        {%- assign default_wl_link = section.settings.waitlist_url -%}
      {%- endif -%}
      <div class="rack-waitlist-btn-wrap-top">
        <a href="{{ default_wl_link }}" class="rack-waitlist-btn" title="Join the exclusive atelier waitlist">
          {%- if section.settings.show_btn_sparkle != false -%}
            <span class="btn-sparkle" aria-hidden="true">{{ section.settings.btn_sparkle_icon | default: '✦' }}</span>
          {%- endif -%}
          <span>{{ section.settings.top_waitlist_btn_text | default: section.settings.waitlist_btn_text | default: 'Join the waitlist' }}</span>
          {%- if section.settings.show_btn_arrow != false -%}
            <span class="btn-arrow" aria-hidden="true">{{ section.settings.btn_arrow_icon | default: '⟶' }}</span>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}

    <!-- The Boutique Rail & Clothes Rack Stage -->
    <div class="hanger-rack-stage" tabIndex="0" role="region" aria-label="Interactive Clothes Rack">
      <!-- Scrollable / Draggable Track of Hanging Garments -->
      <div class="hanger-rack-track-wrap">
        <div class="hanger-rack-track" id="HangerTrack-{{ section.id }}">
          <!-- Physical Overhead Rail Bar travelling with the rack -->
          <div class="hanger-rail-bar" aria-hidden="true">
            <div class="rail-rod"><span class="rail-rod-core"></span></div>
            <div class="rail-bracket bracket-left"><span class="bracket-cap"></span></div>
            <div class="rail-bracket bracket-right"><span class="bracket-cap"></span></div>
            <div class="rail-highlight"><span class="highlight-line"></span></div>
          </div>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- assign look_num = forloop.index -%}
              {%- assign fallback_idx = forloop.index0 | modulo: 6 | plus: 1 -%}
              {%- assign default_front_file = 'hanger-look-' | append: fallback_idx | append: '.png' -%}
              {%- assign default_side_file = 'hanger-look-' | append: fallback_idx | append: '-side.png' -%}

              {%- assign dress_front_src = default_front_file | asset_url -%}
              {%- if block.settings.custom_image != blank -%}
                {%- assign dress_front_src = block.settings.custom_image | image_url: width: 800 -%}
              {%- elsif block.settings.product != blank and block.settings.product.featured_image != blank -%}
                {%- assign dress_front_src = block.settings.product.featured_image | image_url: width: 800 -%}
              {%- endif -%}

              {%- assign dress_side_src = default_side_file | asset_url -%}
              {%- if block.settings.custom_side_image != blank -%}
                {%- assign dress_side_src = block.settings.custom_side_image | image_url: width: 800 -%}
              {%- endif -%}

              {%- assign dress_title = block.settings.title -%}
              {%- if dress_title == blank and block.settings.product != blank -%}
                {%- assign dress_title = block.settings.product.title -%}
              {%- endif -%}
              {%- if dress_title == blank -%}
                {%- assign dress_title = 'Atelier Look ' | append: look_num -%}
              {%- endif -%}

              {%- assign dress_price = block.settings.price -%}
              {%- if dress_price == blank and block.settings.product != blank -%}
                {%- assign dress_price = block.settings.product.price | money -%}
              {%- endif -%}

              {%- assign default_inspect_link = routes.root_url | append: 'pages/product-inspect' | replace: '//', '/' -%}
              {%- if section.settings.inspect_url != blank -%}
                {%- assign default_inspect_link = section.settings.inspect_url -%}
              {%- endif -%}
              {%- assign dress_link = default_inspect_link -%}
              {%- if block.settings.link != blank -%}
                {%- assign dress_link = block.settings.link -%}
              {%- elsif block.settings.product != blank and block.settings.product.url != blank -%}
                {%- assign dress_link = block.settings.product.url -%}
              {%- endif -%}

              {%- assign outfit_display_name = block.settings.outfit_name -%}
              {%- if outfit_display_name == blank -%}
                {%- assign outfit_display_name = 'Teekhi Bella Outfit ' | append: forloop.index -%}
              {%- endif -%}

              <!-- Individual Hanging Garment Unit -->
              <div
                class="hanger-item"
                data-index="{{ forloop.index0 }}"
                data-title="{{ dress_title | escape }}"
                data-outfit-name="{{ outfit_display_name | escape }}"
                data-price="{{ dress_price | escape }}"
                data-tag="{{ block.settings.tag | default: 'LOOK ' | append: look_num }}"
                data-link="{{ dress_link }}"
                {{ block.shopify_attributes }}
              >
                <!-- Whole Assembly that Pivots around top hook contact point -->
                <div class="hanger-assembly">
                  <!-- Distinct Side & Front Wire Hangers -->
                  <div class="hanger-wire-wrapper" aria-hidden="true">
                    <!-- Slender Side View Hanger (Visible at rest on rail) -->
                    <svg
                      class="hanger-wire-svg hanger-wire-side"
                      viewBox="0 0 64 84"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M 32 4 C 22 4, 15 11, 15 20 C 15 29, 26 34, 32 39 L 32 47"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        class="hook-curve"
                      />
                      <path
                        d="M 32 4 C 36 4, 38 6, 38 8"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                      />
                      <path
                        d="M 23 76 C 27 62, 29 53, 32 47 C 35 53, 37 62, 41 76"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M 24 76 L 40 76"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>

                    <!-- Wide Front View Hanger (Revealed on hover) -->
                    <svg
                      class="hanger-wire-svg hanger-wire-front"
                      viewBox="0 0 160 84"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M 80 4 C 70 4, 63 11, 63 20 C 63 29, 74 34, 80 39 L 80 47"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        class="hook-curve"
                      />
                      <path
                        d="M 80 4 C 84 4, 86 6, 86 8"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                      />
                      <path
                        d="M 12 76 L 80 47 L 148 76"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M 15 76 L 145 76"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>
                  </div>

                  <!-- Hanging Garment Silhouette (Dual Side-to-Front 3D Pivot Engine) -->
                  <div class="hanger-garment-wrap">
                    <div class="hanger-garment-inner">
                      <!-- Side Profile (Default resting view on boutique rail) -->
                      <img
                        src="{{ dress_side_src }}"
                        alt="{{ dress_title | escape }} — Side View"
                        class="hanger-garment-img garment-side-img"
                        loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                        width="360"
                        height="700"
                      >
                      <!-- Front Profile (Revealed on hover / tap) -->
                      <img
                        src="{{ dress_front_src }}"
                        alt="{{ dress_title | escape }} — Front View"
                        class="hanger-garment-img garment-front-img"
                        loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                        width="360"
                        height="700"
                      >
                      <!-- Soft Dynamic Drop Shadow on the Atelier Wall -->
                      <div class="hanger-garment-shadow" aria-hidden="true"><span></span></div>
                    </div>
                  </div>

                  <!-- Delicate Swing Price Tag dangling from the hanger -->
                  <div class="hanger-swing-tag" aria-hidden="true">
                    <div class="tag-thread"><span></span></div>
                    <div class="tag-body">
                      <span class="tag-code">{{ block.settings.tag | default: 'LOOK ' | append: look_num }}</span>
                      <span class="tag-name">{{ dress_title }}</span>
                      {%- if dress_price != blank -%}
                        <span class="tag-price">{{ dress_price }}</span>
                      {%- endif -%}
                    </div>
                  </div>

                  <!-- Interactive Action Overlay Button / Link -->
                  <a href="#waitlistReservationSection" class="hanger-action-hitbox" aria-label="Reserve {{ dress_title | escape }}" data-look-title="{{ dress_title | escape }}" data-look-index="{{ forloop.index }}">
                    <span class="sr-only">Reserve {{ dress_title }}</span>
                  </a>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- Optional subtle ambient bottom hint -->
      <div class="hanger-rack-hint" aria-hidden="true">
        <span class="hint-icon">{{ section.settings.hint_icon_left | default: '⟵' }}</span>
        <span class="hint-text">{{ section.settings.hint_text | default: 'Hover to sway • Drag along the rack' }}</span>
        <span class="hint-icon">{{ section.settings.hint_icon_right | default: '⟶' }}</span>
      </div>

      </div>

    <!-- Yellow Bench Outfit Title Display (Six Caps Typography) -->
    <a href="#waitlistReservationSection" class="hanger-bench-outfit-title" id="BenchOutfitTitle" title="Reserve Atelier Look">
      <span class="bench-outfit-text">Teekhi Bella Outfit 1</span>
    </a>

    <!-- Bottom Waitlist Call To Action (Under Yellow Bench) -->
    <div class="rack-waitlist-btn-wrap-bottom">
      <a href="#waitlistReservationSection" class="rack-waitlist-btn" title="Join the Exclusive Waitlist">
        <span>{{ section.settings.bottom_waitlist_btn_text | default: section.settings.waitlist_btn_text | default: 'JOIN THE WAITLIST' }}</span>
      </a>
    </div>
  </div>
</section>

<!-- ==========================================================================
     ATELIER WAITLIST RESERVATION FORM (RIGHT UNDER JOIN THE WAITLIST)
     ========================================================================== -->
<section id="waitlistReservationSection" class="atelier-waitlist-section">
  <div class="atelier-waitlist-container">
    <div class="atelier-waitlist-card">
      <form id="atelierInlineWaitlistForm" class="atelier-waitlist-form" novalidate>

        <!-- FULL NAME (Above Email) -->
        <div class="wl-field">
          <label for="waitlistFullName">FULL NAME</label>
          <input 
            type="text" 
            id="waitlistFullName" 
            name="fullName" 
            placeholder="Your full name" 
            autocomplete="name" 
            required
          >
        </div>

        <!-- EMAIL -->
        <div class="wl-field">
          <label for="waitlistEmail">EMAIL</label>
          <input 
            type="email" 
            id="waitlistEmail" 
            name="email" 
            placeholder="name@example.com" 
            autocomplete="email" 
            required
          >
        </div>

        <!-- PHONE -->
        <div class="wl-field">
          <label for="waitlistPhone">PHONE</label>
          <div class="wl-phone-row">
            <span class="wl-phone-cc">+91</span>
            <input 
              type="tel" 
              id="waitlistPhone" 
              name="phone" 
              placeholder="98765 43210" 
              maxlength="10" 
              pattern="[0-9]{10}"
              required
            >
          </div>
        </div>

        <!-- STATE -->
        <div class="wl-field">
          <label for="waitlistState">STATE</label>
          <select id="waitlistState" name="state" required>
            <option value="" disabled selected>Select state</option>
            <option value="Andhra Pradesh">Andhra Pradesh</option>
            <option value="Arunachal Pradesh">Arunachal Pradesh</option>
            <option value="Assam">Assam</option>
            <option value="Bihar">Bihar</option>
            <option value="Chhattisgarh">Chhattisgarh</option>
            <option value="Delhi">Delhi (NCR)</option>
            <option value="Goa">Goa</option>
            <option value="Gujarat">Gujarat</option>
            <option value="Haryana">Haryana</option>
            <option value="Himachal Pradesh">Himachal Pradesh</option>
            <option value="Jharkhand">Jharkhand</option>
            <option value="Karnataka">Karnataka</option>
            <option value="Kerala">Kerala</option>
            <option value="Madhya Pradesh">Madhya Pradesh</option>
            <option value="Maharashtra">Maharashtra</option>
            <option value="Manipur">Manipur</option>
            <option value="Meghalaya">Meghalaya</option>
            <option value="Mizoram">Mizoram</option>
            <option value="Nagaland">Nagaland</option>
            <option value="Odisha">Odisha</option>
            <option value="Punjab">Punjab</option>
            <option value="Rajasthan">Rajasthan</option>
            <option value="Sikkim">Sikkim</option>
            <option value="Tamil Nadu">Tamil Nadu</option>
            <option value="Telangana">Telangana</option>
            <option value="Tripura">Tripura</option>
            <option value="Uttar Pradesh">Uttar Pradesh</option>
            <option value="Uttarakhand">Uttarakhand</option>
            <option value="West Bengal">West Bengal</option>
            <option value="Other / International">Other / International</option>
          </select>
        </div>

        <!-- PIECES OF INTEREST -->
        <div class="wl-field">
          <div class="wl-field-header">
            <label>PIECES OF INTEREST</label>
            <span class="wl-select-hint">SELECT MULTIPLE</span>
          </div>
          <div class="wl-pieces-chips" id="wlPiecesChips">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- assign look_idx = forloop.index -%}
                {%- assign look_title = block.settings.title -%}
                {%- if look_title == blank and block.settings.product != blank -%}
                  {%- assign look_title = block.settings.product.title -%}
                {%- endif -%}
                {%- if look_title == blank -%}
                  {%- assign look_title = 'Atelier Look ' | append: look_idx -%}
                {%- endif -%}
                {%- assign short_title = look_title -%}
                {%- if forloop.index == 1 -%}{%- assign short_title = '01 Archival Gown' -%}{%- endif -%}
                {%- if forloop.index == 2 -%}{%- assign short_title = '02 Mirror Lehenga' -%}{%- endif -%}
                {%- if forloop.index == 3 -%}{%- assign short_title = '03 Saree Gown' -%}{%- endif -%}
                {%- if forloop.index == 4 -%}{%- assign short_title = '04 Botanical Set' -%}{%- endif -%}
                {%- if forloop.index == 5 -%}{%- assign short_title = '05 Halter Gown' -%}{%- endif -%}
                <button type="button" class="wl-piece-chip{% if forloop.first %} is-selected{% endif %}" data-value="{{ look_title | escape }}" data-index="{{ forloop.index }}">
                  <span class="wl-chip-check">✓</span>
                  <span class="wl-chip-text">{{ short_title }}</span>
                </button>
              {%- endfor -%}
            {%- else -%}
              <button type="button" class="wl-piece-chip is-selected" data-value="Archival Manuscript Corset Gown" data-index="1">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">01 Archival Gown</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="Heritage Mural Mirror Lehenga" data-index="2">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">02 Mirror Lehenga</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="Rose-Coral Shimmer Saree Gown" data-index="3">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">03 Saree Gown</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="Midnight Botanical Co-ord Set" data-index="4">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">04 Botanical Set</span>
              </button>
              <button type="button" class="wl-piece-chip" data-value="Bordeaux Peplum Halter Gown" data-index="5">
                <span class="wl-chip-check">✓</span>
                <span class="wl-chip-text">05 Halter Gown</span>
              </button>
            {%- endif -%}
          </div>
        </div>

        <!-- PREFERRED SIZE -->
        <div class="wl-field">
          <label>PREFERRED SIZE</label>
          <div class="wl-size-row" role="radiogroup" aria-label="Preferred size">
            <button type="button" class="wl-size-pill" data-size="XS">XS</button>
            <button type="button" class="wl-size-pill" data-size="S">S</button>
            <button type="button" class="wl-size-pill is-selected" data-size="M">M</button>
            <button type="button" class="wl-size-pill" data-size="L">L</button>
            <button type="button" class="wl-size-pill" data-size="XL">XL</button>
          </div>
          <input type="hidden" id="waitlistPreferredSize" name="preferredSize" value="M">
        </div>

        <!-- SUBMIT RESERVATION BUTTON -->
        <button type="submit" class="wl-submit-btn" id="waitlistSubmitBtn">
          <span>SUBMIT RESERVATION</span>
          <span aria-hidden="true">⟶</span>
        </button>

        <!-- PRIVACY NOTE / DISCLAIMER -->
        <p class="wl-privacy-note">
          By signing up, you agree to receive private collection drops &amp; access via WhatsApp / SMS. View our privacy policy and terms of service for more info.
        </p>

        <!-- INLINE SUCCESS NOTIFICATION -->
        <div class="wl-success-inline" id="waitlistSuccessNotification" style="display: none;">
          <div class="wl-success-icon">✦</div>
          <p class="wl-success-title">RESERVATION SECURED</p>
          <p class="wl-success-sub" id="waitlistSuccessDetails"></p>
        </div>

      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clothes Hanger Rack",
  "tag": "section",
  "class": "section-hanger-rack",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Built-in Header (Eyebrow, Heading, Subheading)",
      "default": false,
      "info": "Uncheck if you are using the separate Rack Eyebrow, Heading, and Subheading sections above the rack."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Tagline",
      "default": "Pretty with a by the way"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Dream Rack"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your Teekhi Bella outfit"
    },
    {
      "type": "header",
      "content": "Waitlist Call To Action Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_waitlist_buttons",
      "label": "Show Waitlist Buttons",
      "default": true,
      "info": "Master toggle for waitlist buttons."
    },
    {
      "type": "checkbox",
      "id": "show_top_waitlist_btn",
      "label": "Show Top Button (Above Rail)",
      "default": true
    },
    {
      "type": "text",
      "id": "top_waitlist_btn_text",
      "label": "Top Button Label",
      "default": "Join the waitlist"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_waitlist_btn",
      "label": "Show Bottom Button (Under Rail)",
      "default": true
    },
    {
      "type": "text",
      "id": "bottom_waitlist_btn_text",
      "label": "Bottom Button Label",
      "default": "Join the waitlist"
    },
    {
      "type": "text",
      "id": "waitlist_btn_text",
      "label": "Fallback Button Label",
      "default": "Join the waitlist"
    },
    {
      "type": "url",
      "id": "waitlist_url",
      "label": "Waitlist Page Link",
      "info": "Leave blank to link automatically to /pages/waitlist"
    },
    {
      "type": "header",
      "content": "Button Embellishments"
    },
    {
      "type": "checkbox",
      "id": "show_btn_sparkle",
      "label": "Show Sparkle Symbol",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_sparkle_icon",
      "label": "Sparkle Symbol",
      "default": "✦"
    },
    {
      "type": "color",
      "id": "btn_sparkle_color",
      "label": "Sparkle Symbol Color",
      "default": "#d4af37"
    },
    {
      "type": "checkbox",
      "id": "show_btn_arrow",
      "label": "Show Arrow Symbol",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_arrow_icon",
      "label": "Arrow Symbol",
      "default": "⟶"
    },
    {
      "type": "header",
      "content": "Button Font Design & Typography"
    },
    {
      "type": "select",
      "id": "btn_font_source",
      "label": "Button Font Family",
      "options": [
        { "value": "sixcaps", "label": "Six Caps (Tall Condensed — New Brand Standard)" },
        { "value": "brand", "label": "Brand Sans (Plus Jakarta Sans)" },
        { "value": "ahsing", "label": "Ahsing (Typogama Couture)" },
        { "value": "ragara", "label": "Ragara (Couture Serif)" },
        { "value": "syne", "label": "Syne (Modern Luxury)" },
        { "value": "bodoni", "label": "Bodoni Moda (Editorial Vogue)" },
        { "value": "playfair", "label": "Playfair Display (Romantic Serif)" },
        { "value": "italiana", "label": "Italiana (Milano Couture)" },
        { "value": "cinzel", "label": "Cinzel (Grand Roman)" },
        { "value": "cormorant", "label": "Cormorant Garamond (Elegance)" },
        { "value": "outfit", "label": "Outfit (Ultra Clean Sans)" },
        { "value": "shopify", "label": "Shopify Font Library (Select below)" },
        { "value": "custom", "label": "Custom Font Name" }
      ],
      "default": "sixcaps"
    },
    {
      "type": "font_picker",
      "id": "btn_font",
      "label": "Button Font (Shopify Library)",
      "default": "assistant_n4",
      "info": "Active when 'Shopify Font Library' is selected above."
    },
    {
      "type": "text",
      "id": "custom_btn_font",
      "label": "Custom Button Font Name",
      "info": "e.g. Montserrat, Syne, Cinzel"
    },
    {
      "type": "range",
      "id": "btn_font_size",
      "label": "Button Font Size (px)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "btn_font_weight",
      "label": "Button Font Weight",
      "options": [
        { "value": "300", "label": "300 (Light)" },
        { "value": "400", "label": "400 (Regular)" },
        { "value": "500", "label": "500 (Medium)" },
        { "value": "600", "label": "600 (Semi-Bold)" },
        { "value": "700", "label": "700 (Bold)" },
        { "value": "800", "label": "800 (Extra Bold)" }
      ],
      "default": "600"
    },
    {
